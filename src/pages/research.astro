---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostPlate from '../components/PostPlate.astro';
import SocialIcon from '../components/SocialIcon.astro';
import { samplePosts, getPostUrl } from '../data/posts';
import { siteConfig } from '../data/siteConfig';

const researchPapers = samplePosts.filter((p) => p.postType === "academic_paper");
const { eyebrow, title, description, specializations } = siteConfig.pages.research;
---

<BaseLayout
  title={`${title} | ${siteConfig.author.name}`}
  description={description}
  pageType="collection"
  breadcrumbs={[
    { name: "Home", url: "/" },
    { name: "Research & Publications", url: "/research" },
  ]}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <!-- Header -->
    <div class="border-b border-[var(--border-color)] pb-10 mb-12 space-y-6">
      <div>
        <span class="text-xs font-mono uppercase tracking-wider text-[var(--accent)] font-semibold">
          {eyebrow}
        </span>
        <h1 class="text-3xl sm:text-5xl font-bold font-sans tracking-tight text-[var(--text-primary)] mt-1.5 mb-4">
          {title}
        </h1>
        <p class="text-base sm:text-lg font-serif text-[var(--text-secondary)] leading-relaxed max-w-3xl">
          {description}
        </p>
      </div>

      <!-- Quick Metrics Bar -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 py-4 px-5 rounded-2xl bg-[var(--bg-secondary)]/50 border border-[var(--border-color)] text-center font-sans">
        <div>
          <span class="block text-xl font-bold text-[var(--text-primary)]">{researchPapers.length}</span>
          <span class="text-xs text-[var(--text-secondary)]">Research Publications</span>
        </div>
        <div class="border-l border-[var(--border-color)]">
          <span class="block text-xl font-bold text-[var(--text-primary)]">Simte &amp; Kaipeng</span>
          <span class="text-xs text-[var(--text-secondary)]">Primary Languages</span>
        </div>
        <div class="border-l border-[var(--border-color)]">
          <span class="block text-xl font-bold text-[var(--text-primary)]">100% Free</span>
          <span class="text-xs text-[var(--text-secondary)]">Open Access PDFs</span>
        </div>
        <div class="border-l border-[var(--border-color)]">
          <span class="block text-xl font-bold text-[var(--text-primary)]">APA &amp; BibTeX</span>
          <span class="text-xs text-[var(--text-secondary)]">1-Click Citations</span>
        </div>
      </div>

      <!-- Core Research Fields Badges -->
      {specializations?.length > 0 && (
        <div class="flex flex-wrap items-center gap-2 pt-1 font-sans text-xs">
          <span class="font-semibold uppercase tracking-wider text-[var(--text-secondary)] mr-1">
            Specializations:
          </span>
          {specializations.map((spec) => (
            <span class="px-2.5 py-1 rounded-md bg-[var(--bg-primary)] border border-[var(--border-color)] text-[var(--text-primary)] font-medium">
              {spec}
            </span>
          ))}
        </div>
      )}
    </div>

    <!-- Publications List -->
    <div class="space-y-12">
      {researchPapers.map((paper, index) => (
        <article class="group rounded-2xl border border-[var(--border-color)] bg-[var(--bg-primary)] hover:border-[var(--accent)]/40 p-6 sm:p-8 transition-all duration-200 shadow-xs hover:shadow-md">
          <div class="grid grid-cols-1 md:grid-cols-12 gap-6 lg:gap-8 items-center">
            <!-- Left Monograph Plate (Larger, academic portrait book ratio) -->
            <div class="md:col-span-5 lg:col-span-4">
              <a href={getPostUrl(paper)} class="block group-hover:opacity-95 transition-opacity">
                <PostPlate post={paper} aspect="aspect-[4/3] sm:aspect-[3/4]" />
              </a>
            </div>

            <!-- Right Paper Metadata & Abstract -->
            <div class="md:col-span-7 lg:col-span-8 space-y-4">
              {/* Journal & Status Badges (Spacious layout, no cramping) */}
              <div class="flex flex-wrap items-center gap-2.5 text-xs font-sans">
                <span class="px-2.5 py-0.5 rounded-full font-mono font-semibold uppercase tracking-wider bg-blue-500/10 text-blue-600 dark:text-blue-400 border border-blue-500/20 text-[11px]">
                  ✓ Peer-Reviewed
                </span>
                {paper.doi ? (
                  <a
                    href={`https://doi.org/${paper.doi}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="px-2.5 py-0.5 rounded-full font-mono font-semibold uppercase tracking-wider bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 text-[11px] hover:underline inline-flex items-center gap-1"
                  >
                    <span>DOI Indexed</span>
                    <SocialIcon name="external" class="w-3 h-3" />
                  </a>
                ) : paper.issn ? (
                  <span class="px-2.5 py-0.5 rounded-full font-mono text-[11px] text-[var(--text-secondary)] bg-[var(--bg-secondary)] border border-[var(--border-color)]">
                    ISSN Indexed
                  </span>
                ) : (
                  <span class="px-2.5 py-0.5 rounded-full font-mono text-[11px] text-amber-600 dark:text-amber-400 bg-amber-500/10 border border-amber-500/20">
                    Archival Monograph
                  </span>
                )}
                <span class="text-[var(--text-secondary)] hidden sm:inline">•</span>
                <span class="font-serif italic text-xs text-[var(--text-secondary)]">
                  {paper.journal}
                </span>
              </div>

              {/* Title */}
              <h2 class="text-xl sm:text-2xl font-bold font-sans tracking-tight text-[var(--text-primary)] group-hover:text-[var(--accent)] transition-colors leading-snug">
                <a href={getPostUrl(paper)}>
                  {paper.title}
                </a>
              </h2>

              {/* Volume & Identifier Bar */}
              <div class="flex flex-wrap items-center gap-3 text-xs font-mono text-[var(--text-secondary)]">
                {paper.volume && <span>{paper.volume}</span>}
                {paper.issn && <span>ISSN: {paper.issn}</span>}
                {paper.doi && (
                  <span class="text-[var(--accent)]">
                    doi:{paper.doi}
                  </span>
                )}
              </div>

              {/* Abstract Preview */}
              {paper.abstract && (
                <div class="text-sm font-serif text-[var(--text-secondary)] leading-relaxed bg-[var(--bg-secondary)]/40 p-4 rounded-xl border border-[var(--border-color)]">
                  <span class="font-sans font-bold text-xs uppercase tracking-wider text-[var(--text-primary)] block mb-1">
                    Abstract:
                  </span>
                  <p class="line-clamp-3">
                    {paper.abstract}
                  </p>
                </div>
              )}

              {/* Action Buttons: Read Full, Download PDF, Cite */}
              <div class="flex flex-wrap items-center gap-3 pt-2 font-sans text-xs font-semibold">
                <a
                  href={getPostUrl(paper)}
                  class="px-4 py-2 rounded-lg bg-[var(--text-primary)] text-[var(--bg-primary)] hover:opacity-90 transition-opacity inline-flex items-center gap-1.5"
                >
                  Read Full Paper
                  <span aria-hidden="true">→</span>
                </a>

                {paper.pdfUrl && (
                  <a
                    href={paper.pdfUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="px-4 py-2 rounded-lg border border-[var(--border-color)] bg-[var(--bg-secondary)] text-[var(--text-primary)] hover:border-[var(--accent)] hover:text-[var(--accent)] transition-all inline-flex items-center gap-1.5 font-mono"
                  >
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                    </svg>
                    Download PDF
                  </a>
                )}

                <a
                  href={`${getPostUrl(paper)}#cite-publication`}
                  class="px-3.5 py-2 rounded-lg border border-dashed border-[var(--border-color)] text-[var(--text-secondary)] hover:text-[var(--accent)] hover:border-[var(--accent)] transition-all inline-flex items-center gap-1 font-mono text-[11px]"
                >
                  Cite (BibTeX / APA)
                </a>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Open Access & Archival Statement Footer -->
    <div class="mt-16 p-6 sm:p-8 rounded-2xl border border-[var(--border-color)] bg-[var(--bg-secondary)]/30 font-sans space-y-3">
      <div class="flex items-center gap-2">
        <h3 class="text-sm font-bold uppercase tracking-wider text-[var(--text-primary)]">
          Open Access & Archival Commitment
        </h3>
      </div>
      <p class="text-sm font-serif text-[var(--text-secondary)] leading-relaxed">
        In accordance with Green Open Access standards, all peer-reviewed postprints and documentation datasets are made freely available without paywalls. Field recordings and grammatical analyses are preserved to serve both scientific linguistic typology and indigenous language revitalization.
      </p>
      <div class="pt-2 flex flex-wrap items-center gap-4 text-xs font-mono text-[var(--text-secondary)]">
        <span>ORCID: <a href="https://orcid.org/0009-0008-9045-3527" target="_blank" rel="noopener noreferrer" class="text-[var(--accent)] hover:underline">0009-0008-9045-3527</a></span>
        <span>•</span>
        <span>Affiliation: North-Eastern Hill University (NEHU), Shillong</span>
      </div>
    </div>
  </div>
</BaseLayout>
