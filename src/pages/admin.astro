      localStorage.removeItem('hk_gh_user');
      updateGhAuthUI();
      showToast("Cleared GitHub token");
      return;
    }

    showToast("Verifying token with GitHub...");
    try {
      let res = await fetch("https://api.github.com/user", {
        headers: { "Authorization": `Bearer ${token}`, "Accept": "application/vnd.github.v3+json" }
      });
      if (!res.ok && res.status === 401) {
        res = await fetch("https://api.github.com/user", {
          headers: { "Authorization": `token ${token}`, "Accept": "application/vnd.github.v3+json" }
        });
      }

      if (res.ok) {
        const data = await res.json();
        localStorage.setItem('hk_gh_token', token);
        localStorage.setItem('hk_gh_user', data.login || "User");
        updateGhAuthUI();
        showToast(`Connected as @${data.login}!`);
        await testGitHubConnection();
      } else {
        alert("Invalid token: GitHub rejected this token. Please verify the token string.");
      }
    } catch (err) {
      alert("Failed to connect to GitHub API: " + err.message);
    }
  });

