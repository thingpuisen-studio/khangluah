<script is:inline define:vars={{ existingPostsData, PRESET_TIPS, PRESET_THEMES, siteConfig, defaultSiteConfig, scannedAssets }}>
  let currentType = "poem";
  let existingPosts = existingPostsData || [];
  let currentTipClass = "bg-purple-500";
  let currentTipName = "Purple";
  let currentThemeClass = "from-slate-950 via-purple-950 to-stone-950 text-purple-100";
  let currentThemeName = "Poetic Violet";

  const GH_REPO_OWNER = "lianhangluah";
  const GH_REPO_NAME = "hkhangluah";

  function getGhToken() {
    return localStorage.getItem('hk_gh_token') || "";
  }

  function getGhUser() {
    return localStorage.getItem('hk_gh_user') || "";
  }

  function updateGhAuthUI() {
    const token = getGhToken();
    const user = getGhUser();
    const isAuth = Boolean(token);

    const loginGate = document.getElementById('admin-login-gate');
    const mainUi = document.getElementById('admin-main-ui');
    const ghDot = document.getElementById('gh-dot');
    const ghStatusText = document.getElementById('gh-status-text');
    const btnGhAuthText = document.getElementById('btn-gh-auth-text');
    const cfgGhPill = document.getElementById('cfg-gh-pill');
    const cfgGhTokenInput = document.getElementById('cfg-gh-token-input');
    const btnSettingsOAuthText = document.getElementById('btn-settings-gh-oauth-text');

    if (cfgGhTokenInput && token) {
      cfgGhTokenInput.value = token;
    }

    if (isAuth) {
      if (loginGate) loginGate.classList.add('hidden');
      if (mainUi) mainUi.classList.remove('hidden');

      if (ghDot) {
        ghDot.className = "w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse";
      }
      if (ghStatusText) {
        ghStatusText.textContent = user ? `@${user}` : "Connected";
        ghStatusText.className = "text-emerald-400 font-semibold";
      }
      if (btnGhAuthText) {
        btnGhAuthText.textContent = "Sign Out";
      }
      if (cfgGhPill) {
        cfgGhPill.textContent = user ? `Connected as @${user}` : "Connected";
        cfgGhPill.className = "text-[10px] font-mono px-2.5 py-1 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 font-bold self-start sm:self-auto";
      }
      if (btnSettingsOAuthText) {
        btnSettingsOAuthText.textContent = "Reconnect GitHub";
      }
    } else {
      if (loginGate) loginGate.classList.remove('hidden');
      if (mainUi) mainUi.classList.add('hidden');

      if (ghDot) {
        ghDot.className = "w-1.5 h-1.5 rounded-full bg-amber-500";
      }
      if (ghStatusText) {
        ghStatusText.textContent = "Disconnected";
        ghStatusText.className = "";
      }
      if (btnGhAuthText) {
        btnGhAuthText.textContent = "Sign In";
      }
      if (cfgGhPill) {
        cfgGhPill.textContent = "Disconnected";
        cfgGhPill.className = "text-[10px] font-mono px-2.5 py-1 rounded-full bg-amber-500/10 text-amber-500 border border-amber-500/20 font-bold self-start sm:self-auto";
      }
      if (btnSettingsOAuthText) {
        btnSettingsOAuthText.textContent = "Sign in with GitHub";
      }
    }
  }

  async function commitFileToGitHub(filePath, fileContent, commitMsg) {
    const token = getGhToken();
    if (!token) throw new Error("No GitHub authentication token found. Please sign in with GitHub or enter a token in Site Settings.");
    if (token === 'local_dev_token') {
      throw new Error("You are using local mock mode. Your post is saved in your local browser storage. To push real commits to GitHub, connect your GitHub account or paste a GitHub Personal Access Token.");
    }

    let sha = null;
    let authHeader = `Bearer ${token}`;

    try {
      const getRes = await fetch(`https://api.github.com/repos/${GH_REPO_OWNER}/${GH_REPO_NAME}/contents/${filePath}`, {
        headers: {
          "Authorization": authHeader,
          "Accept": "application/vnd.github.v3+json"
        }
      });
      if (getRes.ok) {
        const data = await getRes.json();
        sha = data.sha;
      } else if (getRes.status === 401) {
        // Fallback to classic token scheme if Bearer rejected
        authHeader = `token ${token}`;
        const retryRes = await fetch(`https://api.github.com/repos/${GH_REPO_OWNER}/${GH_REPO_NAME}/contents/${filePath}`, {
          headers: {
            "Authorization": authHeader,
            "Accept": "application/vnd.github.v3+json"
          }
        });
        if (retryRes.ok) {
          const data = await retryRes.json();
          sha = data.sha;
        }
      }
    } catch {
      // New file, proceed
    }

    const base64Content = btoa(unescape(encodeURIComponent(fileContent)));

    const body = {
      message: commitMsg,
      content: base64Content,
      branch: "main"
    };
    if (sha) {
      body.sha = sha;
    }

    const putRes = await fetch(`https://api.github.com/repos/${GH_REPO_OWNER}/${GH_REPO_NAME}/contents/${filePath}`, {
      method: "PUT",
      headers: {
        "Authorization": authHeader,
        "Accept": "application/vnd.github.v3+json",
        "Content-Type": "application/json"
      },
      body: JSON.stringify(body)
    });

    if (!putRes.ok) {
      const errData = await putRes.json().catch(() => ({}));
      let msg = errData.message || `HTTP ${putRes.status}: ${putRes.statusText}`;
      if (putRes.status === 404 || putRes.status === 403) {
        msg = `GitHub ${putRes.status} (${errData.message || putRes.statusText}):\nThe token cannot write to repository ${GH_REPO_OWNER}/${GH_REPO_NAME}.\n\nTo fix:\n1. If using GitHub App (Ov23liELdAzmQwnCaqaO): Go to GitHub Settings -> Developer settings -> GitHub Apps -> Permissions: set "Contents" to "Read & write". Then in "Install App" sidebar, install it on ${GH_REPO_OWNER}/${GH_REPO_NAME}.\n2. Or generate a Personal Access Token with "repo" scope and save it in Site Settings.`;
      }
      throw new Error(msg);
    }

    return await putRes.json();
  }

  async function commitBinaryFileToGitHub(filePath, rawBase64, commitMsg) {
    const token = getGhToken();
    if (!token) throw new Error("No GitHub token available");

    let sha = null;
    let authHeader = `Bearer ${token}`;

    try {
      const getRes = await fetch(`https://api.github.com/repos/${GH_REPO_OWNER}/${GH_REPO_NAME}/contents/${filePath}`, {
        headers: { "Authorization": authHeader, "Accept": "application/vnd.github.v3+json" }
      });
      if (getRes.ok) {
        const data = await getRes.json();
        sha = data.sha;
      }
    } catch {
      // New file
    }

    const body = {
      message: commitMsg,
      content: rawBase64,
      branch: "main"
    };
    if (sha) {
      body.sha = sha;
    }

    const putRes = await fetch(`https://api.github.com/repos/${GH_REPO_OWNER}/${GH_REPO_NAME}/contents/${filePath}`, {
      method: "PUT",
      headers: {
        "Authorization": authHeader,
        "Accept": "application/vnd.github.v3+json",
        "Content-Type": "application/json"
      },
      body: JSON.stringify(body)
    });

    if (!putRes.ok) {
      const errData = await putRes.json().catch(() => ({}));
      throw new Error(errData.message || `Failed to commit image (${putRes.status})`);
    }

    return await putRes.json();
  }

  async function deleteFileFromGitHub(filePath, commitMsg) {
    const token = getGhToken();
    if (!token) throw new Error("No GitHub token available");

    let authHeader = `Bearer ${token}`;
    const getRes = await fetch(`https://api.github.com/repos/${GH_REPO_OWNER}/${GH_REPO_NAME}/contents/${filePath}`, {
      headers: {
        "Authorization": authHeader,
        "Accept": "application/vnd.github.v3+json"
      }
    });

    if (!getRes.ok) {
      return true;
    }

    const fileData = await getRes.json();
    const sha = fileData.sha;

    const delRes = await fetch(`https://api.github.com/repos/${GH_REPO_OWNER}/${GH_REPO_NAME}/contents/${filePath}`, {
      method: "DELETE",
      headers: {
        "Authorization": authHeader,
        "Accept": "application/vnd.github.v3+json",
        "Content-Type": "application/json"
      },
      body: JSON.stringify({
        message: commitMsg,
        sha: sha,
        branch: "main"
      })
    });

    if (!delRes.ok) {
      const errData = await delRes.json().catch(() => ({}));
      throw new Error(errData.message || `Failed to delete from GitHub (HTTP ${delRes.status})`);
    }

    return await delRes.json();
  }

