  // Client-Side WebP Converter & Dropzone
  function convertFileToWebP(file, maxWidth = 1400, quality = 0.85) {
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = (e) => {
        const img = new Image();
        img.onload = () => {
          const canvas = document.createElement('canvas');
          let width = img.width;
          let height = img.height;
          if (width > maxWidth) {
            height = Math.round((height * maxWidth) / width);
            width = maxWidth;
          }
          canvas.width = width;
          canvas.height = height;
          const ctx = canvas.getContext('2d');
          ctx.drawImage(img, 0, 0, width, height);
          const dataUrl = canvas.toDataURL('image/webp', quality);
          resolve(dataUrl);
        };
        img.onerror = reject;
        img.src = e.target.result;
      };
      reader.onerror = reject;
      reader.readAsDataURL(file);
    });
  }

  async function processAssetFileForWebP(file) {
    if (!file || !file.type.startsWith('image/')) {
      showToast("Please choose a valid image file");
      return;
    }
    showToast("Converting to WebP...");
    try {
      const originalBytes = file.size;
      const baseSlug = file.name
        .replace(/\.[^.]+$/, '')
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-|-$/g, '');
      const defaultFilename = `${baseSlug || 'image'}.webp`;

      const webpDataUrl = await convertFileToWebP(file, 1400, 0.85);
      const head = 'data:image/webp;base64,';
      const base64Len = webpDataUrl.length - head.length;
      const webpBytes = Math.round((base64Len * 3) / 4);

      const origKb = originalBytes > 1024 * 1024
        ? (originalBytes / (1024 * 1024)).toFixed(1) + ' MB'
        : Math.round(originalBytes / 1024) + ' KB';
      const webpKb = webpBytes > 1024 * 1024
        ? (webpBytes / (1024 * 1024)).toFixed(1) + ' MB'
        : Math.round(webpBytes / 1024) + ' KB';
      const percentSaved = Math.max(0, Math.round(((originalBytes - webpBytes) / originalBytes) * 100));

      pendingWebpDataUrl = webpDataUrl;
      pendingWebpBytes = webpBytes;

      const thumb = document.getElementById('asset-pending-thumb');
      const filenameInput = document.getElementById('asset-pending-filename');
      const stats = document.getElementById('asset-pending-stats');
      const previewBox = document.getElementById('asset-pending-preview');

      if (thumb) thumb.src = webpDataUrl;
      if (filenameInput) filenameInput.value = defaultFilename;
      if (stats) stats.textContent = `WebP Compressed: ${origKb} -> ${webpKb} (${percentSaved}% file size reduction)`;
      if (previewBox) previewBox.classList.remove('hidden');

      showToast("Converted to WebP! Ready to commit.");
    } catch (err) {
      console.error("WebP conversion error:", err);
      showToast("Failed to convert image to WebP");
    }
  }

  const assetDropzone = document.getElementById('asset-dropzone');
  const assetFileInput = document.getElementById('asset-upload-input');

  assetDropzone?.addEventListener('click', () => {
