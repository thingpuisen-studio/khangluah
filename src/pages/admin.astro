  function syncSiteConfigFromForm() {
    const getVal = (id) => document.getElementById(id)?.value.trim() || "";
    const getChk = (id) => !!document.getElementById(id)?.checked;

    if (!activeSiteConfig.author) activeSiteConfig.author = {};
    activeSiteConfig.author.name = getVal('cfg-author-name');
    activeSiteConfig.author.shortName = getVal('cfg-author-shortname');
    activeSiteConfig.author.title = getVal('cfg-author-title');
    activeSiteConfig.author.qualification = getVal('cfg-author-qualification');
    activeSiteConfig.author.affiliation = getVal('cfg-author-affiliation');
    activeSiteConfig.author.location = getVal('cfg-author-location');
    activeSiteConfig.author.shortBio = getVal('cfg-author-shortbio');
    
    const fullBioRaw = document.getElementById('cfg-author-fullbio')?.value || "";
    activeSiteConfig.author.fullBio = fullBioRaw.split(/\n\s*\n/).map(s => s.trim()).filter(Boolean);
    activeSiteConfig.author.avatar = getVal('cfg-author-avatar');
    activeSiteConfig.author.fullPhoto = getVal('cfg-author-photo');
    activeSiteConfig.author.researchAreas = getVal('cfg-author-research-areas').split(',').map(s => s.trim()).filter(Boolean);

    if (!activeSiteConfig.author.metrics) activeSiteConfig.author.metrics = {};
    activeSiteConfig.author.metrics.papersCountValue = getVal('cfg-metric-papers-val');
    activeSiteConfig.author.metrics.papersCountLabel = getVal('cfg-metric-papers-lbl');
    activeSiteConfig.author.metrics.documentedLanguagesValue = getVal('cfg-metric-langs-val');
    activeSiteConfig.author.metrics.documentedLanguagesLabel = getVal('cfg-metric-langs-lbl');

    if (!activeSiteConfig.author.actionButtons) activeSiteConfig.author.actionButtons = [];
    if (activeSiteConfig.author.actionButtons.length >= 1) {
      activeSiteConfig.author.actionButtons[0].label = getVal('cfg-btn1-label');
      activeSiteConfig.author.actionButtons[0].href = getVal('cfg-btn1-href');
    }
    if (activeSiteConfig.author.actionButtons.length >= 2) {
      activeSiteConfig.author.actionButtons[1].label = getVal('cfg-btn2-label');
      activeSiteConfig.author.actionButtons[1].href = getVal('cfg-btn2-href');
    }

    if (!activeSiteConfig.fieldworkSpotlight) activeSiteConfig.fieldworkSpotlight = {};
    activeSiteConfig.fieldworkSpotlight.enabled = getChk('cfg-spotlight-enabled');
    activeSiteConfig.fieldworkSpotlight.badge = getVal('cfg-spotlight-badge');
    activeSiteConfig.fieldworkSpotlight.subtitle = getVal('cfg-spotlight-sub');
    activeSiteConfig.fieldworkSpotlight.studyLinkText = getVal('cfg-spotlight-link-text');
    activeSiteConfig.fieldworkSpotlight.studyLinkHref = getVal('cfg-spotlight-link-href');
    activeSiteConfig.fieldworkSpotlight.words = [
      { src: getVal('cfg-spotlight-w1-src'), gloss: getVal('cfg-spotlight-w1-gloss') },
      { src: getVal('cfg-spotlight-w2-src'), gloss: getVal('cfg-spotlight-w2-gloss') },
      { src: getVal('cfg-spotlight-w3-src'), gloss: getVal('cfg-spotlight-w3-gloss') },
      { src: getVal('cfg-spotlight-w4-src'), gloss: getVal('cfg-spotlight-w4-gloss') },
    ];
    activeSiteConfig.fieldworkSpotlight.translation = getVal('cfg-spotlight-trans');

    if (!activeSiteConfig.pages) activeSiteConfig.pages = {};
    if (!activeSiteConfig.pages.research) activeSiteConfig.pages.research = {};
    activeSiteConfig.pages.research.eyebrow = getVal('cfg-page-research-eyebrow');
    activeSiteConfig.pages.research.title = getVal('cfg-page-research-title');
    activeSiteConfig.pages.research.description = getVal('cfg-page-research-desc');

    if (!activeSiteConfig.pages.feed) activeSiteConfig.pages.feed = {};
    activeSiteConfig.pages.feed.eyebrow = getVal('cfg-page-feed-eyebrow');
    activeSiteConfig.pages.feed.title = getVal('cfg-page-feed-title');
    activeSiteConfig.pages.feed.description = getVal('cfg-page-feed-desc');

    if (!activeSiteConfig.pages.poems) activeSiteConfig.pages.poems = {};
    activeSiteConfig.pages.poems.eyebrow = getVal('cfg-page-poems-eyebrow');
    activeSiteConfig.pages.poems.title = getVal('cfg-page-poems-title');
    activeSiteConfig.pages.poems.description = getVal('cfg-page-poems-desc');

    if (!activeSiteConfig.pages.archive) activeSiteConfig.pages.archive = {};
    activeSiteConfig.pages.archive.eyebrow = getVal('cfg-page-archive-eyebrow');
    activeSiteConfig.pages.archive.title = getVal('cfg-page-archive-title');
    activeSiteConfig.pages.archive.description = getVal('cfg-page-archive-desc');

    if (!activeSiteConfig.pages.about) activeSiteConfig.pages.about = {};
    activeSiteConfig.pages.about.eyebrow = getVal('cfg-page-about-eyebrow');
    activeSiteConfig.pages.about.title = getVal('cfg-page-about-title');
    activeSiteConfig.pages.about.subtitle = getVal('cfg-page-about-sub');

    if (!activeSiteConfig.pages.socials) activeSiteConfig.pages.socials = {};
    activeSiteConfig.pages.socials.headline = getVal('cfg-page-socials-head');
    activeSiteConfig.pages.socials.subheadline = getVal('cfg-page-socials-sub');

    if (!activeSiteConfig.footer) activeSiteConfig.footer = {};
    activeSiteConfig.footer.bio = getVal('cfg-footer-bio');
    activeSiteConfig.footer.documentedLanguages = getVal('cfg-footer-langs');
    activeSiteConfig.footer.copyright = getVal('cfg-footer-copy');
    activeSiteConfig.footer.standardsNotice = getVal('cfg-footer-standards');
    activeSiteConfig.footer.backToTopText = getVal('cfg-footer-backtotop');
    activeSiteConfig.footer.showAdminLink = getChk('cfg-footer-show-admin');
    activeSiteConfig.footer.adminLinkLabel = getVal('cfg-footer-admin-label');

    updateSiteConfigCodeOutput();
  }

  function generateSiteConfigTs(cfg) {
    return `import { url } from '../utils/url';

export interface NavItemConfig {
  id: string;
  label: string;
  href: string;
  enabled: boolean;
  order: number;
}

export interface ActionButtonConfig {
  id: string;
  label: string;
  href: string;
  icon: string;
  enabled: boolean;
}

export interface GlossWordUnit {
  src: string;
  gloss: string;
}

export interface FieldworkSpotlightConfig {
  enabled: boolean;
  badge: string;
  subtitle: string;
  studyLinkText: string;
  studyLinkHref: string;
  words: GlossWordUnit[];
  translation: string;
}

export interface SocialLinkConfig {
  id: string;
  title: string;
  handle: string;
  description: string;
  category: "academic" | "social" | "direct";
  badge: string;
  href: string;
  icon: string;
  colorTheme: string;
  isActive: boolean;
  order: number;
}

export interface DocumentedLanguageInfo {
  name: string;
  iso: string;
  branch: string;
  focus: string;
  region: string;
}

export interface PoeticThemeInfo {
  title: string;
  theme: string;
  desc: string;
}

export interface SiteConfig {
  meta: {
    siteTitle: string;
    siteDescription: string;
    authorName: string;
  };
  author: {
    name: string;
    shortName: string;
    title: string;
    affiliation: string;
    qualification: string;
    location: string;
    locationDetail: string;
    email: string;
    orcid: string;
    scholar: string;
    github: string;
    bluesky: string;
    avatar: string;
    fullPhoto: string;
    shortBio: string;
    fullBio: string[];
    researchAreas: string[];
    metrics: {
      papersCountLabel: string;
      papersCountValue: string;
      documentedLanguagesLabel: string;
      documentedLanguagesValue: string;
    };
    actionButtons: ActionButtonConfig[];
  };
  navigation: NavItemConfig[];
  fieldworkSpotlight: FieldworkSpotlightConfig;
  socialLinks: SocialLinkConfig[];
  pages: {
    home: {
      recentHeading: string;
      recentDesc: string;
      allPostsText: string;
    };
    research: {
      eyebrow: string;
      title: string;
      description: string;
      specializations: string[];
    };
    feed: {
      eyebrow: string;
      title: string;
      description: string;
      researchNoticeText: string;
      researchNoticeBtnText: string;
    };
    poems: {
      eyebrow: string;
      title: string;
      description: string;
      themes: PoeticThemeInfo[];
    };
    archive: {
      eyebrow: string;
      title: string;
      description: string;
      researchNoticeText: string;
      researchNoticeBtnText: string;
    };
    about: {
      eyebrow: string;
      title: string;
      subtitle: string;
      languagesDocumented: DocumentedLanguageInfo[];
      contactNote: string;
    };
    socials: {
      headline: string;
      subheadline: string;
      note: string;
    };
  };
  footer: {
    bio: string;
    documentedLanguages: string;
    copyright: string;
    standardsNotice: string;
    backToTopText: string;
    showAdminLink: boolean;
    adminLinkLabel: string;
  };
}

export const defaultSiteConfig: SiteConfig = ${JSON.stringify(cfg, null, 2)};

export const siteConfig: SiteConfig = defaultSiteConfig;
`;
  }

  function updateSiteConfigCodeOutput() {
    const el = document.getElementById('site-config-code-output');
    if (el) {
      el.querySelector('code').textContent = generateSiteConfigTs(activeSiteConfig);
    }
  }

  // Site Config Form listeners
  document.getElementById('site-config-form')?.addEventListener('input', syncSiteConfigFromForm);
  document.getElementById('site-config-form')?.addEventListener('change', syncSiteConfigFromForm);

  // Save Settings Locally button
  document.getElementById('btn-save-site-config')?.addEventListener('click', () => {
    syncSiteConfigFromForm();
    localStorage.setItem(cfgStorageKey, JSON.stringify(activeSiteConfig));
    updateStorageStatusBadge(true);
    showToast("Site configuration saved locally!");
  });

  // Reset to Defaults button
  document.getElementById('btn-reset-site-config')?.addEventListener('click', () => {
    if (confirm("Reset all site settings back to default configurations? Any unsaved local overrides will be removed.")) {
      localStorage.removeItem(cfgStorageKey);
      activeSiteConfig = JSON.parse(JSON.stringify(defaultSiteConfig));
      populateSiteConfigForm();
      updateStorageStatusBadge(false);
      showToast("Reset to default configuration!");
    }
  });

  // Copy siteConfig.ts code
  document.getElementById('btn-copy-site-config-code')?.addEventListener('click', () => {
    syncSiteConfigFromForm();
    const code = generateSiteConfigTs(activeSiteConfig);
    navigator.clipboard.writeText(code).then(() => showToast("siteConfig.ts copied to clipboard!"));
  });

  // Download siteConfig.ts file
  document.getElementById('btn-download-site-config-file')?.addEventListener('click', () => {
    syncSiteConfigFromForm();
    const code = generateSiteConfigTs(activeSiteConfig);
    const blob = new Blob([code], { type: "text/typescript;charset=utf-8" });
    const link = document.createElement("a");
    link.href = URL.createObjectURL(blob);
    link.download = "siteConfig.ts";
    link.click();
    showToast("Downloaded siteConfig.ts");
  });

  // Merge locally published posts into catalog
  try {
    const published = JSON.parse(localStorage.getItem('hk_cms_published_posts') || '[]');
    if (Array.isArray(published) && published.length > 0) {
      published.forEach(pub => {
        if (!existingPosts.some(p => p.slug === pub.slug)) {
          existingPosts.unshift(pub);
        }
        renderPublishedItemToCatalog(pub);
      });
      const catBadge = document.getElementById('catalog-count-badge');
      if (catBadge) catBadge.textContent = existingPosts.length;
    }
  } catch (e) {
    console.error("Failed to load locally published posts", e);
  }

  // Init
  updateDraftsBadge();
  updateLivePreview();
  populateSiteConfigForm();
</script>

