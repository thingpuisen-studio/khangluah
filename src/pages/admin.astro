---
import BaseLayout from '../layouts/BaseLayout.astro';
import { samplePosts, getPostUrl } from '../data/posts';
import { url } from '../utils/url';
import { PRESET_TIPS, PRESET_THEMES, plateConfigs } from '../data/plateConfigs';
import { siteConfig, defaultSiteConfig } from '../data/siteConfig';

// Provide initial data for existing posts to the client
const existingPostsData = samplePosts.map((p) => {
  const plate = plateConfigs[p.slug];
  return {
    slug: p.slug,
    title: p.title,
    subtitle: p.subtitle || "",
    excerpt: p.excerpt,
    postType: p.postType,
    category: p.category,
    date: p.date,
    year: p.year,
    readingTime: p.readingTime,
    language: p.language || "English",
    tags: p.tags,
    coverImage: p.coverImage || "",
    journal: p.journal || "",
    volume: p.volume || "",
    issn: p.issn || "",
    doi: p.doi || "",
    authors: p.authors || "H. Kapginlian",
    abstract: p.abstract || "",
    featuredCouplet: p.sections?.[0]?.blockquote?.text || "",
    pullQuote: p.sections?.[0]?.blockquote?.text || "",
    themeClass: p.themeClass || plate?.themeClass || "from-slate-950 via-purple-950 to-stone-950 text-purple-100",
    accentBarClass: p.accentBarClass || plate?.accentBarClass || "bg-purple-500",
    headerLabel: p.headerLabel || plate?.headerLabel || "",
    formula: p.formula || plate?.formula || "",
    formulaSub: p.formulaSub || plate?.formulaSub || "",
    body: p.sections?.flatMap((s) => {
      const list: string[] = [];
      if (s.heading && s.heading !== p.title) list.push(`## ${s.heading}`);
      if (s.blockquote?.text) list.push(`> ${s.blockquote.text.replace(/\n/g, '\n> ')}`);
      if (s.paragraphs) list.push(...s.paragraphs);
      return list;
    }).join("\n\n") || p.excerpt || "",
  };
});
---

<BaseLayout
  title="Admin CMS Studio | H. Kapginlian"
  description="Local Content Management Studio with Markdown Composer, Live Preview, and Content Catalog."
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-10 pb-28 md:pb-16 font-sans">
    
    <!-- Top Header Bar -->
    <header class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-[var(--border-color)]">
      <div>
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
          <span class="text-xs font-mono uppercase tracking-wider text-[var(--accent)] font-semibold">
            Content Management Studio
          </span>
          <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-[var(--bg-secondary)] border border-[var(--border-color)] text-[var(--text-secondary)]">
            Local Mode
          </span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-[var(--text-primary)] mt-1">
          Admin CMS
        </h1>
      </div>

      <div class="flex items-center gap-2">
        <a
          href={url("/")}
          class="min-h-[44px] px-3.5 py-2 text-xs rounded-xl border border-[var(--border-color)] bg-[var(--bg-secondary)] hover:bg-[var(--bg-primary)] text-[var(--text-primary)] transition-colors inline-flex items-center gap-1.5"
        >
          <span>View Live Site</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
        <button
          type="button"
          id="btn-save-draft"
          class="min-h-[44px] px-3.5 py-2 text-xs rounded-xl border border-[var(--border-color)] bg-[var(--bg-secondary)] hover:bg-[var(--bg-primary)] text-[var(--text-secondary)] font-medium transition-colors inline-flex items-center gap-1.5 cursor-pointer"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"></path></svg>
          <span>Save Draft</span>
        </button>
        <button
          type="button"
          id="btn-publish-top"
          class="min-h-[44px] px-4 py-2 text-xs rounded-xl bg-emerald-600 text-white font-semibold hover:bg-emerald-700 transition-colors inline-flex items-center gap-1.5 cursor-pointer shadow-xs"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path></svg>
          <span>Publish Post</span>
        </button>
      </div>
    </header>

    <!-- Desktop Navigation Tabs -->
    <div class="hidden md:flex items-center gap-2 py-4 border-b border-[var(--border-color)] overflow-x-auto text-sm font-medium">
      <button
        type="button"
        class="nav-tab-btn px-4 py-2 rounded-xl transition-all cursor-pointer bg-[var(--text-primary)] text-[var(--bg-primary)] font-semibold min-h-[44px] flex items-center gap-1.5"
        data-target="tab-write"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
        <span>Write Content</span>
      </button>
      <button
        type="button"
        class="nav-tab-btn px-4 py-2 rounded-xl transition-all cursor-pointer text-[var(--text-secondary)] hover:bg-[var(--bg-secondary)] min-h-[44px] flex items-center gap-1.5"
        data-target="tab-preview"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
        <span>Live Preview</span>
      </button>
      <button
        type="button"
        class="nav-tab-btn px-4 py-2 rounded-xl transition-all cursor-pointer text-[var(--text-secondary)] hover:bg-[var(--bg-secondary)] min-h-[44px] flex items-center gap-1.5"
        data-target="tab-existing"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
        <span>Catalog (<span id="catalog-count-badge">{samplePosts.length}</span>)</span>
      </button>
      <button
        type="button"
        class="nav-tab-btn px-4 py-2 rounded-xl transition-all cursor-pointer text-[var(--text-secondary)] hover:bg-[var(--bg-secondary)] min-h-[44px] flex items-center gap-1.5"
        data-target="tab-drafts"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path></svg>
        <span>Local Drafts <span id="drafts-count-badge" class="ml-1 text-xs opacity-75 font-mono">(0)</span></span>
      </button>
      <button
        type="button"
        class="nav-tab-btn px-4 py-2 rounded-xl transition-all cursor-pointer text-[var(--text-secondary)] hover:bg-[var(--bg-secondary)] min-h-[44px] flex items-center gap-1.5"
        data-target="tab-code"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path></svg>
        <span>Publish &amp; Code</span>
      </button>
      <button
        type="button"
        class="nav-tab-btn px-4 py-2 rounded-xl transition-all cursor-pointer text-[var(--text-secondary)] hover:bg-[var(--bg-secondary)] min-h-[44px] flex items-center gap-1.5"
        data-target="tab-site-config"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
        <span>Site Settings</span>
      </button>
    </div>

    <!-- MAIN VIEW PANELS -->
    <main class="pt-6">

      <!-- ================= TAB 1: WRITE CONTENT ================= -->
      <section id="tab-write" class="tab-panel space-y-6">
        
        <!-- Content Type Selector Pills -->
        <div class="p-3.5 rounded-2xl bg-[var(--bg-secondary)]/60 border border-[var(--border-color)] space-y-2">
          <label class="block text-xs font-mono uppercase tracking-wider text-[var(--text-secondary)] font-semibold">
            Publication Type:
          </label>
          <div class="grid grid-cols-3 gap-2">
            <button
              type="button"
              class="type-pill-btn p-3 rounded-xl border border-[var(--border-color)] bg-[var(--text-primary)] text-[var(--bg-primary)] font-semibold text-xs sm:text-sm text-center transition-all cursor-pointer"
              data-type="poem"
            >
              <span class="block font-semibold">Poem</span>
            </button>
            <button
              type="button"
              class="type-pill-btn p-3 rounded-xl border border-[var(--border-color)] bg-[var(--bg-primary)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] font-medium text-xs sm:text-sm text-center transition-all cursor-pointer"
              data-type="essay"
            >
              <span class="block font-semibold">Essay / Dispatch</span>
            </button>
            <button
              type="button"
              class="type-pill-btn p-3 rounded-xl border border-[var(--border-color)] bg-[var(--bg-primary)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] font-medium text-xs sm:text-sm text-center transition-all cursor-pointer"
              data-type="academic_paper"
            >
              <span class="block font-semibold">Research Paper</span>
            </button>
          </div>
        </div>

        <!-- Form Fields -->
        <form id="content-form" class="space-y-5">
          <!-- Title & Slug -->
          <div class="grid grid-cols-1 sm:grid-cols-12 gap-4">
            <div class="sm:col-span-8 space-y-1.5">
              <label for="post-title" class="block text-xs font-semibold uppercase tracking-wider text-[var(--text-secondary)]">
                Title <span class="text-rose-500">*</span>
              </label>
              <input
                type="text"
                id="post-title"
                name="title"
                required
                placeholder="e.g. Whispers of the High Mountains"
                class="w-full px-4 py-3 rounded-xl border border-[var(--border-color)] bg-[var(--bg-secondary)]/30 focus:bg-[var(--bg-primary)] focus:border-[var(--accent)] focus:outline-none text-[var(--text-primary)] text-base font-medium transition-all"
              />
            </div>

            <div class="sm:col-span-4 space-y-1.5">
              <label for="post-slug" class="block text-xs font-semibold uppercase tracking-wider text-[var(--text-secondary)]">
                Slug (URL identifier)
              </label>
              <input
                type="text"
                id="post-slug"
                name="slug"
                placeholder="whispers-high-mountains"
                class="w-full px-4 py-3 rounded-xl border border-[var(--border-color)] bg-[var(--bg-secondary)]/30 focus:bg-[var(--bg-primary)] focus:border-[var(--accent)] focus:outline-none text-[var(--text-primary)] font-mono text-xs transition-all"
              />
            </div>
          </div>

          <!-- Subtitle / Overview -->
          <div class="space-y-1.5">
            <label for="post-subtitle" class="block text-xs font-semibold uppercase tracking-wider text-[var(--text-secondary)]">
              Subtitle / Summary Excerpt
            </label>
            <input
              type="text"
              id="post-subtitle"
              name="subtitle"
              placeholder="A lyrical poem on morning mist, mountain ridges, and stillness"
              class="w-full px-4 py-3 rounded-xl border border-[var(--border-color)] bg-[var(--bg-secondary)]/30 focus:bg-[var(--bg-primary)] focus:border-[var(--accent)] focus:outline-none text-[var(--text-primary)] text-sm transition-all"
            />
          </div>

          <!-- Metadata Row: Category, Date, Reading Time -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="space-y-1.5">
              <label for="post-category" class="block text-xs font-semibold uppercase tracking-wider text-[var(--text-secondary)]">
                Category
              </label>
              <input
                type="text"
                id="post-category"
                name="category"
                value="Poetry & Literature"
                class="w-full px-4 py-2.5 rounded-xl border border-[var(--border-color)] bg-[var(--bg-secondary)]/30 focus:bg-[var(--bg-primary)] focus:border-[var(--accent)] focus:outline-none text-[var(--text-primary)] text-sm"
              />
            </div>

            <div class="space-y-1.5">
              <label for="post-date" class="block text-xs font-semibold uppercase tracking-wider text-[var(--text-secondary)]">
                Date
              </label>
              <input
                type="text"
                id="post-date"
                name="date"
                placeholder="October 2026"
                class="w-full px-4 py-2.5 rounded-xl border border-[var(--border-color)] bg-[var(--bg-secondary)]/30 focus:bg-[var(--bg-primary)] focus:border-[var(--accent)] focus:outline-none text-[var(--text-primary)] text-sm font-mono"
              />
            </div>

            <div class="space-y-1.5">
              <label for="post-reading-time" class="block text-xs font-semibold uppercase tracking-wider text-[var(--text-secondary)]">
                Reading Time
              </label>
              <input
                type="text"
                id="post-reading-time"
                name="readingTime"
                value="3 min read"
                class="w-full px-4 py-2.5 rounded-xl border border-[var(--border-color)] bg-[var(--bg-secondary)]/30 focus:bg-[var(--bg-primary)] focus:border-[var(--accent)] focus:outline-none text-[var(--text-primary)] text-sm font-mono"
              />
            </div>
          </div>

          <!-- Tags -->
          <div class="space-y-1.5">
            <label for="post-tags" class="block text-xs font-semibold uppercase tracking-wider text-[var(--text-secondary)]">
              Tags (Comma separated)
            </label>
            <input
              type="text"
              id="post-tags"
              name="tags"
              value="Poetry, Nature, Reflections"
              placeholder="Poetry, Nature, Mountains, Solitude"
              class="w-full px-4 py-2.5 rounded-xl border border-[var(--border-color)] bg-[var(--bg-secondary)]/30 focus:bg-[var(--bg-primary)] focus:border-[var(--accent)] focus:outline-none text-[var(--text-primary)] text-sm font-mono"
            />
          </div>

          <!-- Cover Image & Media Section -->
          <div class="p-4 rounded-2xl border border-[var(--border-color)] bg-[var(--bg-secondary)]/30 space-y-3">
            <div class="flex items-center justify-between">
              <label for="post-cover" class="block text-xs font-semibold uppercase tracking-wider text-[var(--text-secondary)]">
                Cover Image or Photo
              </label>
              <span class="text-[11px] text-[var(--text-secondary)]">Optional</span>
            </div>
            
            <div class="flex flex-col sm:flex-row gap-3 items-start sm:items-center">
              <input
                type="text"
                id="post-cover"
                name="coverImage"
                placeholder="https://example.com/photo.jpg or /images/author.jpg"
                class="flex-1 w-full px-4 py-2.5 rounded-xl border border-[var(--border-color)] bg-[var(--bg-primary)] text-[var(--text-primary)] text-xs font-mono focus:outline-none"
              />
              
              <label class="min-h-[40px] px-3.5 py-2 rounded-xl border border-[var(--border-color)] bg-[var(--bg-secondary)] hover:bg-[var(--bg-primary)] text-xs font-medium text-[var(--text-primary)] transition-colors cursor-pointer inline-flex items-center gap-1.5 shrink-0">
                <svg class="w-4 h-4 text-[var(--accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                <span>Upload Device Image</span>
                <input type="file" id="image-file-input" accept="image/*" class="hidden" />
              </label>
            </div>

            <!-- Image thumbnail preview -->
            <div id="image-preview-box" class="hidden items-center gap-3 pt-2">
              <img id="image-preview-thumb" src="" alt="Thumbnail" class="w-16 h-12 object-cover rounded-lg border border-[var(--border-color)]" />
              <div class="text-xs text-[var(--text-secondary)]">
                <span class="font-medium text-[var(--text-primary)] block" id="image-preview-name">Selected image</span>
                <button type="button" id="btn-remove-image" class="text-rose-500 hover:underline text-[11px] cursor-pointer">Remove image</button>
              </div>
            </div>
          </div>

          <!-- Preview Card Styling & Colors Section -->
          <div class="p-4 sm:p-5 rounded-2xl border border-[var(--border-color)] bg-[var(--bg-secondary)]/30 space-y-4">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1">
              <div>
                <span class="text-xs font-mono font-bold uppercase tracking-wider text-[var(--accent)] block">
                  Preview Card Styling &amp; Colors
                </span>
                <p class="text-xs text-[var(--text-secondary)] mt-0.5">
                  Configure the top tip spine color and background gradient theme for feed listings and monograph plates.
                </p>
              </div>
              <span class="self-start sm:self-auto text-[10px] font-mono px-2 py-0.5 rounded bg-[var(--bg-primary)] border border-[var(--border-color)] text-[var(--text-secondary)]">
                Card Plate
              </span>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-start">
              <!-- Selectors (Left 7 cols on desktop) -->
              <div class="lg:col-span-7 space-y-4">
                <!-- Tip Accent Color Selector -->
                <div class="space-y-2">
                  <div class="flex items-center justify-between">
                    <label class="text-xs font-semibold text-[var(--text-primary)]">
                      Top Tip / Spine Color
                    </label>
                    <span id="label-selected-tip" class="font-mono text-[11px] text-[var(--accent)] font-medium">Purple</span>
                  </div>

                  <div class="flex flex-wrap gap-2" id="tip-swatches-container">
                    {PRESET_TIPS.map((tip) => (
                      <button
                        type="button"
                        class={`tip-swatch-btn min-h-[38px] px-2.5 py-1.5 rounded-xl border border-[var(--border-color)] bg-[var(--bg-primary)] flex items-center gap-2 cursor-pointer transition-all hover:scale-103 text-xs font-mono ${tip.id === "purple" ? "ring-2 ring-[var(--accent)] border-transparent font-bold" : ""}`}
                        data-tip-id={tip.id}
                        data-tip-name={tip.name}
                        data-tip-class={tip.accentBarClass}
                        title={tip.name}
                      >
                        <span class={`w-3.5 h-3.5 rounded-full ${tip.accentBarClass} shrink-0 shadow-xs`}></span>
                        <span class="text-[11px] text-[var(--text-primary)]">{tip.name}</span>
                      </button>
                    ))}
                  </div>
                  <input type="hidden" id="post-tip-class" name="accentBarClass" value="bg-purple-500" />
                </div>

                <!-- Card Background Gradient Theme Selector -->
                <div class="space-y-2">
                  <div class="flex items-center justify-between">
                    <label class="text-xs font-semibold text-[var(--text-primary)]">
                      Card Background Gradient Theme
                    </label>
                    <span id="label-selected-theme" class="font-mono text-[11px] text-[var(--accent)] font-medium">Poetic Violet</span>
                  </div>

                  <div class="grid grid-cols-2 sm:grid-cols-4 gap-2" id="theme-tiles-container">
                    {PRESET_THEMES.map((theme) => (
                      <button
                        type="button"
                        class={`theme-tile-btn relative p-2.5 rounded-xl border text-left cursor-pointer transition-all hover:scale-102 active:scale-98 overflow-hidden bg-gradient-to-br ${theme.previewBg} ${theme.id === "violet" ? "ring-2 ring-[var(--accent)] border-transparent" : "border-stone-800"}`}
                        data-theme-id={theme.id}
                        data-theme-name={theme.name}
                        data-theme-class={theme.themeClass}
                        title={theme.name}
                      >
                        <div class={`h-1 w-full rounded-full ${theme.accentTip} mb-1.5`}></div>
                        <span class="block text-[11px] font-semibold text-white truncate leading-tight">{theme.name}</span>
                      </button>
                    ))}
                  </div>
                  <input type="hidden" id="post-theme-class" name="themeClass" value="from-slate-950 via-purple-950 to-stone-950 text-purple-100" />
                </div>
              </div>

              <!-- Live Mini Card Simulation (Right 5 cols on desktop) -->
              <div class="lg:col-span-5 flex flex-col items-start w-full">
                <div class="w-full flex items-center justify-between mb-2">
                  <span class="text-[10px] font-mono uppercase tracking-wider text-[var(--text-secondary)] font-semibold">
                    Live Card Simulation
                  </span>
                  <span class="text-[10px] font-mono text-[var(--text-secondary)]">Aspect 16:9</span>
                </div>

                <div
                  id="mini-card-preview"
                  class="w-full relative flex flex-col justify-between overflow-hidden rounded-xl border border-stone-800 p-4 select-none bg-gradient-to-br from-slate-950 via-purple-950 to-stone-950 text-purple-100 aspect-video shadow-md transition-all duration-300"
                >
                  <!-- Fine Top Accent Color Spine -->
                  <div id="mini-card-tip" class="absolute top-0 left-0 right-0 h-1.5 bg-purple-500 transition-colors duration-300"></div>

                  <!-- Subtle Watermark Grid -->
                  <div class="absolute inset-0 opacity-[0.08] pointer-events-none" aria-hidden="true">
                    <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
                      <defs>
                        <pattern id="mini-card-grid" width="20" height="20" patternUnits="userSpaceOnUse">
                          <path d="M 20 0 L 0 0 0 20" fill="none" stroke="currentColor" stroke-width="0.5" />
