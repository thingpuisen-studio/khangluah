          class="nav-tab-btn min-h-[40px] px-3.5 py-2 rounded-lg transition-all cursor-pointer text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-secondary)]/60 flex items-center gap-2"
