---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import { allPosts, samplePosts, getPostUrl } from '../data/posts';
import { url } from '../utils/url';
import { PRESET_TIPS, PRESET_THEMES, plateConfigs } from '../data/plateConfigs';
import { siteConfig, defaultSiteConfig } from '../data/siteConfig';

// Scan all images in public/images directory
const publicDir = path.resolve(process.cwd(), 'public');
const imagesDir = path.resolve(publicDir, 'images');

const scannedAssets: Array<{
  path: string;
  filename: string;
  size: number;
  formattedSize: string;
  usedIn: Array<{ title: string; slug: string; type: string }>;
}> = [];

if (fs.existsSync(imagesDir)) {
  function walk(dir: string) {
    for (const ent of fs.readdirSync(dir, { withFileTypes: true })) {
      const fullPath = path.join(dir, ent.name);
      if (ent.isDirectory()) {
        walk(fullPath);
      } else if (/\.(jpe?g|png|webp|svg|gif|avif)$/i.test(ent.name)) {
        const stat = fs.statSync(fullPath);
        const webPath = '/' + path.relative(publicDir, fullPath).replace(/\\/g, '/');
        const filename = ent.name;
        const formattedSize = stat.size > 1024 * 1024
          ? (stat.size / (1024 * 1024)).toFixed(1) + ' MB'
          : Math.round(stat.size / 1024) + ' KB';
        
        const usedIn: Array<{ title: string; slug: string; type: string }> = [];
        for (const post of allPosts) {
          if (post.coverImage && (post.coverImage === webPath || post.coverImage.endsWith('/' + filename))) {
            usedIn.push({ title: post.title, slug: post.slug, type: 'Cover Image' });
          } else if (post.body && (post.body.includes(webPath) || post.body.includes(filename))) {
            usedIn.push({ title: post.title, slug: post.slug, type: 'Article Body' });
          }
        }
        scannedAssets.push({
          path: webPath,
          filename,
          size: stat.size,
          formattedSize,
          usedIn,
        });
      }
    }
  }
  walk(imagesDir);
}

// Provide initial data for existing posts to the client (including remote drafts)
const existingPostsData = allPosts.map((p) => {
  const plate = plateConfigs[p.slug];
  return {
    slug: p.slug,
    title: p.title,
    subtitle: p.subtitle || "",
    excerpt: p.excerpt,
    postType: p.postType,
    category: p.category,
    date: p.date,
    year: p.year,
    readingTime: p.readingTime,
    language: p.language || "English",
    tags: p.tags,
    coverImage: p.coverImage || "",
    draft: Boolean(p.draft),
    journal: p.journal || "",
    volume: p.volume || "",
    issn: p.issn || "",
    doi: p.doi || "",
    authors: p.authors || "H. Kapginlian",
    abstract: p.abstract || "",
    featuredCouplet: p.sections?.[0]?.blockquote?.text || "",
    pullQuote: p.sections?.[0]?.blockquote?.text || "",
    themeClass: p.themeClass || plate?.themeClass || "from-slate-950 via-purple-950 to-stone-950 text-purple-100",
    accentBarClass: p.accentBarClass || plate?.accentBarClass || "bg-purple-500",
    headerLabel: p.headerLabel || plate?.headerLabel || "",
    formula: p.formula || plate?.formula || "",
    formulaSub: p.formulaSub || plate?.formulaSub || "",
    body: p.sections?.flatMap((s) => {
      const list: string[] = [];
      if (s.heading && s.heading !== p.title) list.push(`## ${s.heading}`);
      if (s.blockquote?.text) list.push(`> ${s.blockquote.text.replace(/\n/g, '\n> ')}`);
      if (s.paragraphs) list.push(...s.paragraphs);
      return list;
    }).join("\n\n") || p.excerpt || "",
  };
});
---

<BaseLayout
