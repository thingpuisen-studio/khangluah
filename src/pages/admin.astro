  // 2. Save Post as Draft in Remote Repo (SPADIRR)
  async function savePostAsRemoteDraft() {
    const token = getGhToken();
    if (!token) {
      alert("GitHub authentication required to save remote drafts. Please sign in with GitHub.");
      window.location.href = "/api/auth/login";
      return;
    }

    const title = titleInput.value.trim();
    if (!title) {
      showToast("Please enter a title before saving remote draft");
      titleInput.focus();
      return;
    }

    const slug = slugInput.value.trim() || title.toLowerCase().replace(/[^a-z0-9]+/g, '-');
    const targetFile = currentType === 'academic_paper' ? `src/data/posts/${slug}.ts` : `src/content/posts/${slug}.md`;

    const confirmed = confirm(`Save draft "${title}" in remote repository (SPADIRR)?\n\nThis will commit to branch 'main' with 'draft: true' so the article is preserved in GitHub but hidden from public readers.`);
    if (!confirmed) return;

    showToast("Committing remote draft to GitHub (SPADIRR)...");

    const btnRemote = document.getElementById('btn-save-remote-draft');
    const btnRemoteBottom = document.getElementById('btn-save-remote-draft-bottom');
    if (btnRemote) btnRemote.textContent = "Saving...";
    if (btnRemoteBottom) btnRemoteBottom.textContent = "Saving to GitHub...";

    try {
      if (pendingImageBase64 && pendingImageBase64.startsWith('data:image/')) {
        const imgPath = `public/images/posts/${slug}.${pendingImageExt}`;
        const rawBase64 = pendingImageBase64.split(',')[1];
        try {
          await commitBinaryFileToGitHub(imgPath, rawBase64, `chore(assets): add draft cover for ${slug}`);
        } catch (imgErr) {
          console.warn("Cover image upload warning:", imgErr);
        }
      }

      generateCode(true, slug, true);
      const draftCode = document.getElementById('code-output').querySelector('code').textContent;

      await commitFileToGitHub(targetFile, draftCode, `draft(content): save draft ${title} (SPADIRR)`);
      showToast(`Draft "${title}" saved in remote repository (SPADIRR)!`);

      const category = categoryInput.value.trim() || "Poetry & Literature";
      const date = dateInput.value.trim() || "October 2026";
      const draftPost = {
        slug,
        title,
        subtitle: subtitleInput.value.trim(),
        category,
        date,
        year: parseInt(date.replace(/\D/g, '').slice(-4)) || 2026,
        readingTime: readingTimeInput.value.trim() || '3 min read',
        tags: tagsInput.value.split(',').map(t => t.trim()).filter(Boolean),
        coverImage: coverInput.value.trim(),
        body: bodyInput.value,
        postType: currentType,
        themeClass: currentThemeClass,
        accentBarClass: currentTipClass,
        draft: true,
        isPublished: false,
      };

      const catIdx = existingPosts.findIndex(p => p.slug === slug);
      if (catIdx >= 0) existingPosts[catIdx] = draftPost;
      else existingPosts.unshift(draftPost);

      renderPublishedItemToCatalog(draftPost);

      const pubModal = document.getElementById('publish-modal');
      if (pubModal) {
        document.getElementById('pub-modal-eyebrow').textContent = "Remote Draft Saved (SPADIRR)";
        document.getElementById('pub-modal-title').textContent = `"${title}"`;
        document.getElementById('pub-modal-filename').textContent = targetFile;
        document.getElementById('pub-modal-notice').textContent =
          "Your draft has been committed directly to GitHub with 'draft: true'. It is safely version-controlled in the repository but hidden from public visitors until you click 'Deploy to Live Site'.";
        const deployBtn = document.getElementById('pub-modal-deploy-live');
        if (deployBtn) deployBtn.classList.remove('hidden');
        pubModal.classList.remove('hidden');
      }
    } catch (ghErr) {
      console.error("Remote draft commit failed:", ghErr);
      showToast(`Remote draft error: ${ghErr.message}`);
      alert(`Remote draft failed: ${ghErr.message}\nYour draft has been saved locally instead.`);
      saveCurrentDraft();
    } finally {
      if (btnRemote) {
        btnRemote.innerHTML = '<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path></svg><span>Save Draft (SPADIRR)</span>';
      }
      if (btnRemoteBottom) {
        btnRemoteBottom.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path></svg><span>Save Draft (SPADIRR)</span>';
      }
    }
  }

  // 1. Save Post Locally (No GitHub Commit, No Cloudflare Rebuild)
  function saveCurrentPostLocally(showModal = true) {
    const title = titleInput.value.trim();
    if (!title) {
      showToast("Please enter a title before saving");
      titleInput.focus();
      return null;
    }

    generateCode();
    const slug = slugInput.value.trim() || title.toLowerCase().replace(/[^a-z0-9]+/g, '-');
    const category = categoryInput.value.trim() || (currentType === 'poem' ? 'Poetry & Literature' : (currentType === 'academic_paper' ? 'Linguistic Research' : 'Cultural Dispatches'));
    const date = dateInput.value.trim() || new Date().toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
    const readingTime = readingTimeInput.value.trim() || '3 min read';
    const body = bodyInput.value;
    const coverImage = coverInput.value.trim();
    const tags = tagsInput.value.split(',').map(t => t.trim()).filter(Boolean);
    const targetFile = currentType === 'academic_paper' ? `src/data/posts/${slug}.ts` : `src/content/posts/${slug}.md`;

    const postItem = {
      slug,
      title,
      subtitle: subtitleInput.value.trim(),
      category,
      date,
      year: parseInt(date.replace(/\D/g, '').slice(-4)) || 2026,
      readingTime,
      tags,
      coverImage,
      body,
      postType: currentType,
      themeClass: currentThemeClass,
      accentBarClass: currentTipClass,
      isPublished: true,
      publishedAt: new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }),
    };

    // Store in localStorage published posts
    try {
      const stored = JSON.parse(localStorage.getItem('hk_cms_published_posts') || '[]');
      const existIdx = stored.findIndex(p => p.slug === slug);
      if (existIdx >= 0) stored[existIdx] = postItem;
      else stored.unshift(postItem);
      localStorage.setItem('hk_cms_published_posts', JSON.stringify(stored));
    } catch (e) {
      console.error(e);
    }

    // Add or update in active memory catalog
    const catIdx = existingPosts.findIndex(p => p.slug === slug);
    if (catIdx >= 0) {
      existingPosts[catIdx] = postItem;
    } else {
      existingPosts.unshift(postItem);
    }
    const catBadge = document.getElementById('catalog-count-badge');
    if (catBadge) catBadge.textContent = existingPosts.length;

    // Render immediately into catalog DOM
    renderPublishedItemToCatalog(postItem);

    showToast(`Saved "${title}" to local catalog!`);

    if (showModal) {
      const pubModal = document.getElementById('publish-modal');
      if (pubModal) {
        document.getElementById('pub-modal-eyebrow').textContent = "Post Saved Locally";
        document.getElementById('pub-modal-title').textContent = `"${title}"`;
        document.getElementById('pub-modal-filename').textContent = targetFile;
        document.getElementById('pub-modal-notice').textContent =
          "Your post has been saved locally to your browser catalog. It is ready for previewing. When you are ready to push to production, click 'Deploy to Live Site'.";
        const deployBtn = document.getElementById('pub-modal-deploy-live');
        if (deployBtn) deployBtn.classList.remove('hidden');
        pubModal.classList.remove('hidden');
      }
    }

    return { slug, title, targetFile, postItem };
  }

  // 2. Deploy Post to Live Site (GitHub API -> Cloudflare Pages)
  async function deployCurrentPostToGitHub() {
    const token = getGhToken();
    if (!token) {
      alert("GitHub authentication required to deploy to the live site. Please sign in with GitHub.");
      window.location.href = "/api/auth/login";
      return;
    }

    const saved = saveCurrentPostLocally(false);
    if (!saved) return;

    const { title, slug, targetFile } = saved;
    const code = document.getElementById('code-output').querySelector('code').textContent;

    const confirmed = confirm(`Deploy "${title}" to GitHub on branch 'main'?\n\nThis will commit directly to the repository and trigger a Cloudflare Pages rebuild for lianhangluah.com.`);
    if (!confirmed) return;

    const deployTop = document.getElementById('btn-deploy-top');
    const deployBottom = document.getElementById('btn-deploy-post');
    const deployModal = document.getElementById('pub-modal-deploy-text');

    if (deployTop) deployTop.textContent = "Deploying...";
    if (deployBottom) deployBottom.textContent = "Deploying to GitHub...";
    if (deployModal) deployModal.textContent = "Deploying...";

    showToast("Committing to GitHub repository...");

    try {
      // 1. Upload standalone web-optimized image file to GitHub if present
      if (pendingImageBase64 && pendingImageBase64.startsWith('data:image/')) {
        const imgPath = `public/images/posts/${slug}.${pendingImageExt}`;
        const rawBase64 = pendingImageBase64.split(',')[1];
        showToast("Uploading optimized cover image to GitHub...");
        try {
          await commitBinaryFileToGitHub(imgPath, rawBase64, `chore(assets): add cover image for ${slug}`);
        } catch (imgErr) {
          console.warn("Cover image upload warning:", imgErr);
        }
      }

      // 2. Generate clean, lightweight markdown pointing to the static asset
      generateCode(true, slug);
      const deployCode = document.getElementById('code-output').querySelector('code').textContent;

      // 3. Commit markdown file
      await commitFileToGitHub(targetFile, deployCode, `feat(content): publish ${title}`);
      showToast("Committed to GitHub! Cloudflare will deploy in ~60s.");

      const pubModal = document.getElementById('publish-modal');
      if (pubModal) {
        document.getElementById('pub-modal-eyebrow').textContent = "Deployed to Live Site";
        document.getElementById('pub-modal-title').textContent = `"${title}"`;
        document.getElementById('pub-modal-filename').textContent = targetFile;
        document.getElementById('pub-modal-notice').textContent =
          "Your post has been committed directly to GitHub on branch 'main'. Cloudflare Pages is rebuilding and deploying to lianhangluah.com within 1 to 2 minutes.";
        const deployBtn = document.getElementById('pub-modal-deploy-live');
        if (deployBtn) deployBtn.classList.add('hidden');
        pubModal.classList.remove('hidden');
      }
    } catch (ghErr) {
      console.error("GitHub deploy failed:", ghErr);
      showToast(`GitHub commit error: ${ghErr.message}. Saved locally.`);
      alert(`GitHub deploy failed: ${ghErr.message}\nYour post is still saved locally.`);
    } finally {
      if (deployTop) {
        deployTop.innerHTML = '<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path></svg><span>Deploy to Live Site</span>';
      }
      if (deployBottom) {
        deployBottom.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path></svg><span>Deploy to Live Site</span>';
      }
      if (deployModal) {
        deployModal.textContent = "Deploy to Live Site";
      }
    }
  }

