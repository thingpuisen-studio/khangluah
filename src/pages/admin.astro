          title="Save Post as Draft in Remote Repo (SPADIRR) - commits to GitHub with draft: true"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path></svg>
          <span>Save Draft (SPADIRR)</span>
        </button>

        <button
          type="button"
          id="btn-deploy-top"
          class="min-h-[40px] px-3.5 py-1.5 text-xs rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white font-medium transition-colors inline-flex items-center gap-1.5 cursor-pointer shadow-xs"
          title="Publish post with draft: false and deploy live to Cloudflare Pages"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path></svg>
          <span>Deploy to Live Site</span>
        </button>

        <button type="button" id="btn-save-post-top" class="hidden" aria-hidden="true"></button>
      </div>
    </div>

    <!-- MAIN VIEW PANELS -->
    <main class="pt-6">

      <!-- ================= TAB 1: WRITE CONTENT ================= -->
      <section id="tab-write" class="tab-panel space-y-6">
        
        <!-- Content Type Selector Pills -->
        <div class="p-3.5 rounded-2xl bg-[var(--bg-secondary)]/60 border border-[var(--border-color)] space-y-2">
          <label class="block text-xs font-mono uppercase tracking-wider text-[var(--text-secondary)] font-semibold">
            Publication Type:
          </label>
          <div class="grid grid-cols-3 gap-2">
            <button
              type="button"
              class="type-pill-btn p-3 rounded-xl border border-[var(--border-color)] bg-[var(--text-primary)] text-[var(--bg-primary)] font-semibold text-xs sm:text-sm text-center transition-all cursor-pointer"
              data-type="poem"
            >
              <span class="block font-semibold">Poem</span>
            </button>
            <button
              type="button"
              class="type-pill-btn p-3 rounded-xl border border-[var(--border-color)] bg-[var(--bg-primary)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] font-medium text-xs sm:text-sm text-center transition-all cursor-pointer"
              data-type="essay"
            >
              <span class="block font-semibold">Essay / Dispatch</span>
            </button>
            <button
              type="button"
              class="type-pill-btn p-3 rounded-xl border border-[var(--border-color)] bg-[var(--bg-primary)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] font-medium text-xs sm:text-sm text-center transition-all cursor-pointer"
              data-type="academic_paper"
            >
              <span class="block font-semibold">Research Paper</span>
            </button>
          </div>
        </div>

        <!-- Form Fields -->
        <form id="content-form" class="space-y-5">
          <!-- Title & Slug -->
          <div class="grid grid-cols-1 sm:grid-cols-12 gap-4">
            <div class="sm:col-span-8 space-y-1.5">
              <label for="post-title" class="block text-xs font-semibold uppercase tracking-wider text-[var(--text-secondary)]">
                Title <span class="text-rose-500">*</span>
              </label>
              <input
                type="text"
                id="post-title"
                name="title"
                required
                placeholder="e.g. Whispers of the High Mountains"
                class="w-full px-4 py-3 rounded-xl border border-[var(--border-color)] bg-[var(--bg-secondary)]/30 focus:bg-[var(--bg-primary)] focus:border-[var(--accent)] focus:outline-none text-[var(--text-primary)] text-base font-medium transition-all"
              />
            </div>

            <div class="sm:col-span-4 space-y-1.5">
              <label for="post-slug" class="block text-xs font-semibold uppercase tracking-wider text-[var(--text-secondary)]">
                Slug (URL identifier)
              </label>
              <input
                type="text"
                id="post-slug"
                name="slug"
                placeholder="whispers-high-mountains"
                class="w-full px-4 py-3 rounded-xl border border-[var(--border-color)] bg-[var(--bg-secondary)]/30 focus:bg-[var(--bg-primary)] focus:border-[var(--accent)] focus:outline-none text-[var(--text-primary)] font-mono text-xs transition-all"
              />
            </div>
          </div>

          <!-- Subtitle / Overview -->
          <div class="space-y-1.5">
            <label for="post-subtitle" class="block text-xs font-semibold uppercase tracking-wider text-[var(--text-secondary)]">
              Subtitle / Summary Excerpt
            </label>
            <input
              type="text"
              id="post-subtitle"
              name="subtitle"
              placeholder="A lyrical poem on morning mist, mountain ridges, and stillness"
              class="w-full px-4 py-3 rounded-xl border border-[var(--border-color)] bg-[var(--bg-secondary)]/30 focus:bg-[var(--bg-primary)] focus:border-[var(--accent)] focus:outline-none text-[var(--text-primary)] text-sm transition-all"
            />
          </div>

          <!-- Metadata Row: Category, Date, Reading Time -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="space-y-1.5">
              <label for="post-category" class="block text-xs font-semibold uppercase tracking-wider text-[var(--text-secondary)]">
                Category
              </label>
              <input
                type="text"
                id="post-category"
                name="category"
                value="Poetry & Literature"
                class="w-full px-4 py-2.5 rounded-xl border border-[var(--border-color)] bg-[var(--bg-secondary)]/30 focus:bg-[var(--bg-primary)] focus:border-[var(--accent)] focus:outline-none text-[var(--text-primary)] text-sm"
              />
            </div>

            <div class="space-y-1.5">
              <label for="post-date" class="block text-xs font-semibold uppercase tracking-wider text-[var(--text-secondary)]">
                Date
              </label>
              <input
                type="text"
                id="post-date"
                name="date"
                placeholder="October 2026"
                class="w-full px-4 py-2.5 rounded-xl border border-[var(--border-color)] bg-[var(--bg-secondary)]/30 focus:bg-[var(--bg-primary)] focus:border-[var(--accent)] focus:outline-none text-[var(--text-primary)] text-sm font-mono"
              />
            </div>

            <div class="space-y-1.5">
              <label for="post-reading-time" class="block text-xs font-semibold uppercase tracking-wider text-[var(--text-secondary)]">
                Reading Time
              </label>
              <input
                type="text"
                id="post-reading-time"
                name="readingTime"
                value="3 min read"
                class="w-full px-4 py-2.5 rounded-xl border border-[var(--border-color)] bg-[var(--bg-secondary)]/30 focus:bg-[var(--bg-primary)] focus:border-[var(--accent)] focus:outline-none text-[var(--text-primary)] text-sm font-mono"
              />
            </div>
          </div>

          <!-- Tags -->
          <div class="space-y-1.5">
            <label for="post-tags" class="block text-xs font-semibold uppercase tracking-wider text-[var(--text-secondary)]">
              Tags (Comma separated)
            </label>
            <input
              type="text"
              id="post-tags"
              name="tags"
              value="Poetry, Nature, Reflections"
              placeholder="Poetry, Nature, Mountains, Solitude"
              class="w-full px-4 py-2.5 rounded-xl border border-[var(--border-color)] bg-[var(--bg-secondary)]/30 focus:bg-[var(--bg-primary)] focus:border-[var(--accent)] focus:outline-none text-[var(--text-primary)] text-sm font-mono"
            />
          </div>

          <!-- Cover Image & Media Section -->
          <div class="p-4 rounded-2xl border border-[var(--border-color)] bg-[var(--bg-secondary)]/30 space-y-3">
            <div class="flex items-center justify-between">
              <label for="post-cover" class="block text-xs font-semibold uppercase tracking-wider text-[var(--text-secondary)]">
                Cover Image or Photo
              </label>
              <span class="text-[11px] text-[var(--text-secondary)]">Optional</span>
            </div>
            
            <div class="flex flex-col sm:flex-row gap-3 items-start sm:items-center">
              <input
                type="text"
                id="post-cover"
                name="coverImage"
                placeholder="https://example.com/photo.jpg or /images/author.jpg"
                class="flex-1 w-full px-4 py-2.5 rounded-xl border border-[var(--border-color)] bg-[var(--bg-primary)] text-[var(--text-primary)] text-xs font-mono focus:outline-none"
              />
              
              <label class="min-h-[40px] px-3.5 py-2 rounded-xl border border-[var(--border-color)] bg-[var(--bg-secondary)] hover:bg-[var(--bg-primary)] text-xs font-medium text-[var(--text-primary)] transition-colors cursor-pointer inline-flex items-center gap-1.5 shrink-0">
                <svg class="w-4 h-4 text-[var(--accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                <span>Upload Device Image</span>
                <input type="file" id="image-file-input" accept="image/*" class="hidden" />
              </label>
            </div>

            <!-- Image thumbnail preview -->
            <div id="image-preview-box" class="hidden items-center gap-3 pt-2">
              <img id="image-preview-thumb" src="" alt="Thumbnail" class="w-16 h-12 object-cover rounded-lg border border-[var(--border-color)]" />
              <div class="text-xs text-[var(--text-secondary)]">
                <span class="font-medium text-[var(--text-primary)] block" id="image-preview-name">Selected image</span>
                <button type="button" id="btn-remove-image" class="text-rose-500 hover:underline text-[11px] cursor-pointer">Remove image</button>
              </div>
            </div>
          </div>

          <!-- Preview Card Styling & Colors Section -->
          <div class="p-4 sm:p-5 rounded-2xl border border-[var(--border-color)] bg-[var(--bg-secondary)]/30 space-y-4">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1">
              <div>
                <span class="text-xs font-mono font-bold uppercase tracking-wider text-[var(--accent)] block">
                  Preview Card Styling &amp; Colors
                </span>
                <p class="text-xs text-[var(--text-secondary)] mt-0.5">
                  Configure the top tip spine color and background gradient theme for feed listings and monograph plates.
                </p>
              </div>
              <span class="self-start sm:self-auto text-[10px] font-mono px-2 py-0.5 rounded bg-[var(--bg-primary)] border border-[var(--border-color)] text-[var(--text-secondary)]">
                Card Plate
              </span>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-start">
              <!-- Selectors (Left 7 cols on desktop) -->
              <div class="lg:col-span-7 space-y-4">
                <!-- Tip Accent Color Selector -->
                <div class="space-y-2">
                  <div class="flex items-center justify-between">
                    <label class="text-xs font-semibold text-[var(--text-primary)]">
                      Top Tip / Spine Color
                    </label>
                    <span id="label-selected-tip" class="font-mono text-[11px] text-[var(--accent)] font-medium">Purple</span>
                  </div>

                  <div class="flex flex-wrap gap-2" id="tip-swatches-container">
                    {PRESET_TIPS.map((tip) => (
                      <button
                        type="button"
                        class={`tip-swatch-btn min-h-[38px] px-2.5 py-1.5 rounded-xl border border-[var(--border-color)] bg-[var(--bg-primary)] flex items-center gap-2 cursor-pointer transition-all hover:scale-103 text-xs font-mono ${tip.id === "purple" ? "ring-2 ring-[var(--accent)] border-transparent font-bold" : ""}`}
                        data-tip-id={tip.id}
                        data-tip-name={tip.name}
                        data-tip-class={tip.accentBarClass}
                        title={tip.name}
                      >
                        <span class={`w-3.5 h-3.5 rounded-full ${tip.accentBarClass} shrink-0 shadow-xs`}></span>
                        <span class="text-[11px] text-[var(--text-primary)]">{tip.name}</span>
                      </button>
                    ))}
                  </div>
                  <input type="hidden" id="post-tip-class" name="accentBarClass" value="bg-purple-500" />
                </div>

                <!-- Card Background Gradient Theme Selector -->
                <div class="space-y-2">
                  <div class="flex items-center justify-between">
                    <label class="text-xs font-semibold text-[var(--text-primary)]">
                      Card Background Gradient Theme
                    </label>
                    <span id="label-selected-theme" class="font-mono text-[11px] text-[var(--accent)] font-medium">Poetic Violet</span>
                  </div>

                  <div class="grid grid-cols-2 sm:grid-cols-4 gap-2" id="theme-tiles-container">
                    {PRESET_THEMES.map((theme) => (
                      <button
                        type="button"
                        class={`theme-tile-btn relative p-2.5 rounded-xl border text-left cursor-pointer transition-all hover:scale-102 active:scale-98 overflow-hidden bg-gradient-to-br ${theme.previewBg} ${theme.id === "violet" ? "ring-2 ring-[var(--accent)] border-transparent" : "border-stone-800"}`}
                        data-theme-id={theme.id}
                        data-theme-name={theme.name}
                        data-theme-class={theme.themeClass}
                        title={theme.name}
                      >
                        <div class={`h-1 w-full rounded-full ${theme.accentTip} mb-1.5`}></div>
                        <span class="block text-[11px] font-semibold text-white truncate leading-tight">{theme.name}</span>
                      </button>
                    ))}
                  </div>
                  <input type="hidden" id="post-theme-class" name="themeClass" value="from-slate-950 via-purple-950 to-stone-950 text-purple-100" />
                </div>
              </div>

              <!-- Live Mini Card Simulation (Right 5 cols on desktop) -->
              <div class="lg:col-span-5 flex flex-col items-start w-full">
                <div class="w-full flex items-center justify-between mb-2">
                  <span class="text-[10px] font-mono uppercase tracking-wider text-[var(--text-secondary)] font-semibold">
                    Live Card Simulation
                  </span>
                  <span class="text-[10px] font-mono text-[var(--text-secondary)]">Aspect 16:9</span>
                </div>

                <div
                  id="mini-card-preview"
                  class="w-full relative flex flex-col justify-between overflow-hidden rounded-xl border border-stone-800 p-4 select-none bg-gradient-to-br from-slate-950 via-purple-950 to-stone-950 text-purple-100 aspect-video shadow-md transition-all duration-300"
                >
                  <!-- Fine Top Accent Color Spine -->
                  <div id="mini-card-tip" class="absolute top-0 left-0 right-0 h-1.5 bg-purple-500 transition-colors duration-300"></div>

                  <!-- Subtle Watermark Grid -->
                  <div class="absolute inset-0 opacity-[0.08] pointer-events-none" aria-hidden="true">
                    <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
                      <defs>
                        <pattern id="mini-card-grid" width="20" height="20" patternUnits="userSpaceOnUse">
                          <path d="M 20 0 L 0 0 0 20" fill="none" stroke="currentColor" stroke-width="0.5" />
                        </pattern>
                      </defs>
                      <rect width="100%" height="100%" fill="url(#mini-card-grid)" />
                    </svg>
                  </div>

                  <!-- Top Header Row -->
                  <div class="relative z-10 flex items-center justify-between gap-1 text-[10px] font-mono tracking-wider text-stone-300 uppercase">
                    <div class="flex items-center gap-1.5 truncate">
                      <span class="inline-block w-1.5 h-1.5 rounded-full bg-stone-400"></span>
                      <span id="mini-card-header" class="truncate font-semibold">POETRY MONOGRAPH</span>
                    </div>
                    <span id="mini-card-year" class="shrink-0 px-1.5 py-0.5 rounded bg-white/10 text-[9px] text-stone-200 font-medium font-mono">
                      2026
                    </span>
                  </div>

                  <!-- Center Typography Block -->
                  <div class="relative z-10 my-auto py-1 text-center space-y-0.5">
                    <span id="mini-card-subcat" class="block text-[9px] font-mono tracking-widest uppercase text-stone-400 font-bold">
                      POETRY
                    </span>
                    <div id="mini-card-title" class="text-sm font-bold font-serif tracking-tight text-white line-clamp-1 drop-shadow-xs">
                      Untitled Publication
                    </div>
                    <div id="mini-card-subtitle" class="text-[10px] font-mono text-stone-300 tracking-tight truncate">
                      3 min read
                    </div>
                  </div>

                  <!-- Bottom Row -->
                  <div class="relative z-10 flex items-center justify-between text-[10px] font-mono pt-2 border-t border-white/10 text-stone-300">
                    <span class="inline-flex items-center gap-1 font-medium">
                      <span class="text-stone-400">#</span>
                      <span id="mini-card-lang">English Verse</span>
                    </span>
                    <span class="text-[9px] text-stone-400 font-sans tracking-wide">
                      H. Kapginlian
                    </span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- ================= 1. POEM TAILORED FIELDS ================= -->
          <div id="section-poem-fields" class="p-4 sm:p-5 rounded-2xl border border-purple-500/30 bg-purple-500/5 space-y-4">
            <div class="flex items-center justify-between pb-2 border-b border-[var(--border-color)]">
              <div>
                <span class="text-xs font-mono font-bold uppercase tracking-wider text-purple-400 block">
                  Poetic Structure &amp; Lyrical Monograph Settings
                </span>
                <p class="text-xs text-[var(--text-secondary)] mt-0.5">
                  Tailored fields for verses, featured stanza hook, meter form, and mood reflections.
                </p>
              </div>
              <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-purple-500/10 border border-purple-500/30 text-purple-400 font-semibold">
                Poem Mode
              </span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
              <div class="space-y-1">
                <label class="block text-[11px] font-semibold text-[var(--text-secondary)]">Poetic Form</label>
                <input type="text" id="poem-form-input" placeholder="e.g. Couplet, Free Verse, Rhymed Quatrain" class="w-full px-3 py-2 rounded-xl border border-[var(--border-color)] bg-[var(--bg-primary)] text-xs text-[var(--text-primary)]" value="Couplet &amp; Quatrain" />
              </div>
              <div class="space-y-1">
                <label class="block text-[11px] font-semibold text-[var(--text-secondary)]">Poetic Theme / Mood</label>
                <input type="text" id="poem-theme-input" placeholder="e.g. Memory, Highland Mist, Solitude" class="w-full px-3 py-2 rounded-xl border border-[var(--border-color)] bg-[var(--bg-primary)] text-xs text-[var(--text-primary)]" value="Memory &amp; Longing" />
              </div>
              <div class="space-y-1">
                <label class="block text-[11px] font-semibold text-[var(--text-secondary)]">Language Tradition</label>
                <input type="text" id="poem-lang-input" placeholder="e.g. English Verse, Simte with Gloss" class="w-full px-3 py-2 rounded-xl border border-[var(--border-color)] bg-[var(--bg-primary)] text-xs text-[var(--text-primary)] font-mono" value="English Verse" />
              </div>
            </div>

            <!-- Featured Couplet / Key Stanza Field -->
            <div class="space-y-1.5 p-3.5 rounded-xl border border-purple-500/20 bg-[var(--bg-primary)]">
              <div class="flex items-center justify-between">
                <label for="poem-couplet-input" class="block text-xs font-bold text-purple-400">
                  Featured Couplet / Key Stanza
                </label>
                <span class="text-[10px] font-mono text-[var(--text-secondary)]">Opening stanza hook &amp; card excerpt</span>
              </div>
              <textarea
                id="poem-couplet-input"
                rows="2"
                placeholder="Where the quiet river winds through evening light,&#10;The shadow of the mountains meets the night."
                class="w-full p-2.5 rounded-lg border border-[var(--border-color)] bg-[var(--bg-secondary)]/30 text-xs font-serif italic text-[var(--text-primary)] leading-relaxed focus:outline-none"
              ></textarea>
            </div>

            <!-- Poet's Reflection / Background Context -->
            <div class="space-y-1">
              <label for="poem-reflection-input" class="block text-[11px] font-semibold text-[var(--text-secondary)]">
                Poet's Reflection / Background Note
              </label>
              <textarea
                id="poem-reflection-input"
                rows="2"
                placeholder="Composed along the river plain at sundown; meditating on evening mist and quiet pathways..."
                class="w-full p-2.5 rounded-lg border border-[var(--border-color)] bg-[var(--bg-primary)] text-xs text-[var(--text-primary)] font-serif"
              ></textarea>
            </div>
          </div>

          <!-- ================= 2. ESSAY TAILORED FIELDS ================= -->
          <div id="section-essay-fields" class="hidden p-4 sm:p-5 rounded-2xl border border-amber-500/30 bg-amber-500/5 space-y-4">
            <div class="flex items-center justify-between pb-2 border-b border-[var(--border-color)]">
              <div>
                <span class="text-xs font-mono font-bold uppercase tracking-wider text-amber-500 block">
                  Essay &amp; Cultural Dispatch Settings
                </span>
                <p class="text-xs text-[var(--text-secondary)] mt-0.5">
                  Tailored fields for fieldwork context, pull quotes, and narrative reflections.
                </p>
              </div>
              <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-amber-500/10 border border-amber-500/30 text-amber-500 font-semibold">
                Essay Mode
              </span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div class="space-y-1">
                <label class="block text-[11px] font-semibold text-[var(--text-secondary)]">Fieldwork Location / Context</label>
                <input type="text" id="essay-location-input" placeholder="e.g. Pamjal Village, Pherzawl District, Manipur" class="w-full px-3 py-2 rounded-xl border border-[var(--border-color)] bg-[var(--bg-primary)] text-xs text-[var(--text-primary)]" />
              </div>
              <div class="space-y-1">
                <label class="block text-[11px] font-semibold text-[var(--text-secondary)]">Primary Topic / Pillar</label>
                <input type="text" id="essay-topic-input" placeholder="e.g. Indigenous Knowledge Systems, Oral History" class="w-full px-3 py-2 rounded-xl border border-[var(--border-color)] bg-[var(--bg-primary)] text-xs text-[var(--text-primary)]" value="Indigenous Knowledge" />
              </div>
            </div>

            <!-- Featured Pull Quote -->
            <div class="space-y-1.5 p-3.5 rounded-xl border border-amber-500/20 bg-[var(--bg-primary)]">
              <div class="flex items-center justify-between">
                <label for="essay-pullquote-input" class="block text-xs font-bold text-amber-500">
                  Featured Pull Quote
                </label>
                <span class="text-[10px] font-mono text-[var(--text-secondary)]">Central thesis or highlight quote</span>
              </div>
              <textarea
                id="essay-pullquote-input"
                rows="2"
                placeholder="Language is more than a system of words and grammar—it is a repository of memory, identity, knowledge, and lived experience."
                class="w-full p-2.5 rounded-lg border border-[var(--border-color)] bg-[var(--bg-secondary)]/30 text-xs font-serif italic text-[var(--text-primary)] leading-relaxed focus:outline-none"
              ></textarea>
              <div class="pt-1">
                <input
                  type="text"
                  id="essay-quote-author"
                  placeholder="Attribution (e.g. H. Kapginlian, Research Philosophy)"
                  class="w-full px-2.5 py-1.5 rounded-md border border-[var(--border-color)] bg-[var(--bg-primary)] text-[11px] text-[var(--text-secondary)] font-mono"
                  value="H. Kapginlian, Research Philosophy"
                />
              </div>
            </div>
          </div>

          <!-- ================= 3. RESEARCH PAPER TAILORED FIELDS ================= -->
          <div id="section-paper-fields" class="hidden p-4 sm:p-5 rounded-2xl border border-indigo-500/30 bg-indigo-500/5 space-y-4">
            <div class="flex items-center justify-between pb-2 border-b border-[var(--border-color)]">
              <div>
                <span class="text-xs font-mono font-bold uppercase tracking-wider text-indigo-400 block">
                  Academic Monograph &amp; Journal Specifications
                </span>
                <p class="text-xs text-[var(--text-secondary)] mt-0.5">
                  Peer-reviewed citations, ISSN/DOI, linguistic taxonomy, and interlinear gloss examples.
                </p>
              </div>
              <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-indigo-500/10 border border-indigo-500/30 text-indigo-400 font-semibold">
                Research Mode
              </span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-3">
              <div class="space-y-1">
                <label class="block text-[11px] font-semibold text-[var(--text-secondary)]">Journal / Publication</label>
                <input type="text" id="paper-journal" placeholder="Language in India" class="w-full px-3 py-2 rounded-xl border border-[var(--border-color)] bg-[var(--bg-primary)] text-xs text-[var(--text-primary)]" />
              </div>
              <div class="space-y-1">
                <label class="block text-[11px] font-semibold text-[var(--text-secondary)]">Volume / Issue / Pages</label>
                <input type="text" id="paper-volume" placeholder="Vol. 23:6, pp. 172-187" class="w-full px-3 py-2 rounded-xl border border-[var(--border-color)] bg-[var(--bg-primary)] text-xs text-[var(--text-primary)]" />
              </div>
              <div class="space-y-1">
                <label class="block text-[11px] font-semibold text-[var(--text-secondary)]">ISSN</label>
                <input type="text" id="paper-issn" placeholder="1930-2940" class="w-full px-3 py-2 rounded-xl border border-[var(--border-color)] bg-[var(--bg-primary)] text-xs text-[var(--text-primary)] font-mono" />
              </div>
              <div class="space-y-1">
                <label class="block text-[11px] font-semibold text-[var(--text-secondary)]">DOI / Resolver</label>
                <input type="text" id="paper-doi" placeholder="10.1234/example" class="w-full px-3 py-2 rounded-xl border border-[var(--border-color)] bg-[var(--bg-primary)] text-xs text-[var(--text-primary)] font-mono" />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
              <div class="space-y-1">
                <label class="block text-[11px] font-semibold text-[var(--text-secondary)]">Authors &amp; Affiliation</label>
                <input type="text" id="paper-authors" placeholder="H. Kapginlian (NEHU, Shillong)" class="w-full px-3 py-2 rounded-xl border border-[var(--border-color)] bg-[var(--bg-primary)] text-xs text-[var(--text-primary)]" value="H. Kapginlian (NEHU, Shillong)" />
              </div>
              <div class="space-y-1">
                <label class="block text-[11px] font-semibold text-[var(--text-secondary)]">Target Language &amp; ISO</label>
