        if (item) {
          item.href = input.value;
          updateSiteConfigCodeOutput();
        }
      });
    });

    container.querySelectorAll('.social-handle-input').forEach(input => {
      input.addEventListener('input', () => {
        const item = activeSiteConfig.socialLinks.find(x => x.id === input.dataset.id);
        if (item) {
          item.handle = input.value;
          updateSiteConfigCodeOutput();
        }
      });
    });

    container.querySelectorAll('.social-desc-input').forEach(input => {
      input.addEventListener('input', () => {
        const item = activeSiteConfig.socialLinks.find(x => x.id === input.dataset.id);
        if (item) {
          item.description = input.value;
          updateSiteConfigCodeOutput();
        }
      });
