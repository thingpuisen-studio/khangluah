  function populateSiteConfigForm() {
    const c = activeSiteConfig;
    const setVal = (id, val) => {
      const el = document.getElementById(id);
      if (el) el.value = val !== undefined && val !== null ? val : "";
    };
    const setChk = (id, val) => {
      const el = document.getElementById(id);
      if (el) el.checked = !!val;
    };

    // Author Identity & Bio
    setVal('cfg-author-name', c.author?.name);
    setVal('cfg-author-shortname', c.author?.shortName);
    setVal('cfg-author-title', c.author?.title);
    setVal('cfg-author-qualification', c.author?.qualification);
    setVal('cfg-author-affiliation', c.author?.affiliation);
    setVal('cfg-author-location', c.author?.location);
    setVal('cfg-author-shortbio', c.author?.shortBio);
    setVal('cfg-author-fullbio', Array.isArray(c.author?.fullBio) ? c.author.fullBio.join('\n\n') : (c.author?.fullBio || ''));
    setVal('cfg-author-avatar', c.author?.avatar);
    setVal('cfg-author-photo', c.author?.fullPhoto);
    setVal('cfg-author-research-areas', Array.isArray(c.author?.researchAreas) ? c.author.researchAreas.join(', ') : (c.author?.researchAreas || ''));

    // Metrics
