  // Simple, rock-solid client-side Markdown parser for live preview
  function renderMarkdown(md) {
    if (!md) return '<p class="text-[var(--text-secondary)] italic">Start typing in the composer to view rendered markdown preview...</p>';

    // Escape raw HTML entities
    let html = md
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');

    // Headings
    html = html.replace(/^### (.*$)/gim, '<h3 class="text-lg font-bold font-sans tracking-tight text-[var(--text-primary)] mt-4 mb-1">$1</h3>');
    html = html.replace(/^## (.*$)/gim, '<h2 class="text-xl font-bold font-sans tracking-tight text-[var(--text-primary)] mt-6 mb-2 border-b border-[var(--border-color)]/60 pb-1">$1</h2>');
    html = html.replace(/^# (.*$)/gim, '<h1 class="text-2xl font-bold font-sans tracking-tight text-[var(--text-primary)] mt-6 mb-2">$1</h1>');

    // Horizontal Rule / Stanza Divider
    html = html.replace(/^---$/gim, '<hr class="my-6 border-[var(--border-color)]" />');

    // Images: ![alt](url)
    html = html.replace(/!\[(.*?)\]\((.*?)\)/gim, '<div class="my-4 rounded-xl overflow-hidden border border-[var(--border-color)]"><img src="$2" alt="$1" class="w-full object-cover max-h-80" /><span class="block p-2 text-center text-xs text-[var(--text-secondary)] font-sans italic">$1</span></div>');

    // Links: [text](url)
    html = html.replace(/\[(.*?)\]\((.*?)\)/gim, '<a href="$2" class="text-[var(--accent)] underline underline-offset-2">$1</a>');

    // Bold & Italics
    html = html.replace(/\*\*(.*?)\*\*/gim, '<strong>$1</strong>');
    html = html.replace(/\*(.*?)\*/gim, '<em>$1</em>');

    // Blockquotes: > quote
    html = html.replace(/^> (.*$)/gim, '<blockquote class="p-3.5 my-3 rounded-xl bg-[var(--bg-secondary)]/60 border-l-4 border-[var(--accent)] font-serif italic text-sm text-[var(--text-primary)] leading-relaxed">$1</blockquote>');

    // Paragraphs / Stanzas (split on double newlines)
    const blocks = html.split(/\n\s*\n/);
    return blocks.map(block => {
      block = block.trim();
      if (!block) return '';
      if (block.startsWith('<h') || block.startsWith('<blockquote') || block.startsWith('<div') || block.startsWith('<hr')) {
        return block;
      }
      return `<p class="whitespace-pre-line text-base font-serif leading-relaxed text-[var(--text-primary)]">${block}</p>`;
    }).join('\n');
  }

