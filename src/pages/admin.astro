  assetDropzone?.addEventListener('dragover', (e) => {
    e.preventDefault();
    assetDropzone.classList.add('border-[var(--accent)]', 'bg-[var(--accent)]/5');
  });

  assetDropzone?.addEventListener('dragleave', () => {
    assetDropzone.classList.remove('border-[var(--accent)]', 'bg-[var(--accent)]/5');
  });

  assetDropzone?.addEventListener('drop', (e) => {
    e.preventDefault();
    assetDropzone.classList.remove('border-[var(--accent)]', 'bg-[var(--accent)]/5');
    const file = e.dataTransfer?.files?.[0];
    if (file) processAssetFileForWebP(file);
  });

  assetFileInput?.addEventListener('change', (e) => {
    const file = e.target.files?.[0];
    if (file) processAssetFileForWebP(file);
  });

  document.getElementById('btn-cancel-pending-asset')?.addEventListener('click', () => {
    pendingWebpDataUrl = null;
    pendingWebpBytes = 0;
    if (assetFileInput) assetFileInput.value = '';
    document.getElementById('asset-pending-preview')?.classList.add('hidden');
    showToast("Upload cancelled");
  });

  document.getElementById('btn-upload-pending-asset')?.addEventListener('click', async () => {
    if (!pendingWebpDataUrl) return;
    const token = getGhToken();
    if (!token) {
      alert("GitHub authentication required to commit assets. Please sign in with GitHub.");
      window.location.href = "/api/auth/login";
      return;
    }

    const filenameInput = document.getElementById('asset-pending-filename');
    let filename = (filenameInput?.value || 'image.webp').trim().toLowerCase().replace(/[^a-z0-9_.-]+/g, '-');
    if (!filename.endsWith('.webp')) filename += '.webp';

    const targetPath = `public/images/posts/${filename}`;
    const webPath = `/images/posts/${filename}`;
    const rawBase64 = pendingWebpDataUrl.split(',')[1];
    const btnText = document.getElementById('btn-upload-asset-text');
    const uploadBtn = document.getElementById('btn-upload-pending-asset');

    if (btnText) btnText.textContent = "Committing to GitHub...";
    uploadBtn?.setAttribute("disabled", "true");

    try {
      await commitBinaryFileToGitHub(targetPath, rawBase64, `chore(assets): upload ${filename} via CMS Studio`);
      showToast(`Committed ${filename} to GitHub!`);

      const newAsset = {
        path: webPath,
        filename: filename,
        size: pendingWebpBytes,
        formattedSize: pendingWebpBytes > 1024 * 1024
          ? (pendingWebpBytes / (1024 * 1024)).toFixed(1) + ' MB'
          : Math.round(pendingWebpBytes / 1024) + ' KB',
        usedIn: [],
      };

      const existingIdx = currentAssets.findIndex((a) => a.path === webPath);
      if (existingIdx >= 0) {
        currentAssets[existingIdx] = newAsset;
      } else {
        currentAssets.unshift(newAsset);
      }

      document.getElementById('asset-pending-preview')?.classList.add('hidden');
      pendingWebpDataUrl = null;
      pendingWebpBytes = 0;
      if (assetFileInput) assetFileInput.value = '';

      renderAssetsGrid(activeAssetFilter);
      alert(`Asset Committed to GitHub!\n\nPath: ${targetPath}\nSize: ${newAsset.formattedSize}\n\nYou can now copy the Markdown code or set it as a post cover image.`);
    } catch (err) {
      console.error("Asset commit error:", err);
      alert(`Asset commit failed: ${err.message}`);
    } finally {
      if (btnText) btnText.textContent = "Commit WebP to GitHub";
      uploadBtn?.removeAttribute("disabled");
    }
  });

  // -------------------------------------------------------------
  // SITE SETTINGS STUDIO (Local Configuration & Export)
  // -------------------------------------------------------------
  const initialSiteConfig = (typeof siteConfig !== 'undefined' && siteConfig) ? siteConfig : defaultSiteConfig;
  let activeSiteConfig = null;
  const cfgStorageKey = 'hk_cms_site_config';

  function updateStorageStatusBadge(isSavedLocally) {
    const badge = document.getElementById('config-storage-status');
    if (!badge) return;
    if (isSavedLocally) {
      badge.textContent = "Saved Locally (localStorage)";
      badge.className = "text-[10px] font-mono px-2 py-0.5 rounded bg-emerald-500/10 border border-emerald-500/30 text-emerald-500 font-semibold";
    } else {
      badge.textContent = "Default Loaded";
      badge.className = "text-[10px] font-mono px-2 py-0.5 rounded bg-[var(--bg-primary)] border border-[var(--border-color)] text-[var(--text-secondary)]";
    }
  }

  function loadStoredSiteConfig() {
    try {
      const stored = localStorage.getItem(cfgStorageKey);
      if (stored) {
        return JSON.parse(stored);
      }
    } catch (e) {
      console.error("Could not parse saved site config", e);
    }
    return null;
  }

  const storedCfg = loadStoredSiteConfig();
  if (storedCfg) {
    activeSiteConfig = storedCfg;
    updateStorageStatusBadge(true);
  } else {
    activeSiteConfig = JSON.parse(JSON.stringify(initialSiteConfig));
    updateStorageStatusBadge(false);
  }

