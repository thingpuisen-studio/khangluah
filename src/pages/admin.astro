          class="min-h-[40px] px-3 py-1.5 text-xs rounded-lg border border-[var(--border-color)]/70 bg-[var(--bg-secondary)]/30 hover:bg-[var(--bg-secondary)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] font-medium transition-colors inline-flex items-center gap-1.5 cursor-pointer"
          title="Save Post as Draft to Local Storage (SPADTLS)"
        >
