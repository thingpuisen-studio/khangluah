  // Test GitHub Connection and Permissions
  async function testGitHubConnection() {
    const token = getGhToken();
    if (!token) {
      alert("No GitHub authentication token found.\n\nPlease sign in with GitHub, or paste a Personal Access Token in Site Settings.");
      return;
    }

    showToast("Testing GitHub connection and repository access...");

    try {
      // 1. Verify user identity
      let userRes = await fetch("https://api.github.com/user", {
        headers: { "Authorization": `Bearer ${token}`, "Accept": "application/vnd.github.v3+json" }
      });
      let authScheme = "Bearer";
      if (!userRes.ok && userRes.status === 401) {
        userRes = await fetch("https://api.github.com/user", {
          headers: { "Authorization": `token ${token}`, "Accept": "application/vnd.github.v3+json" }
        });
        if (userRes.ok) authScheme = "token";
      }

      if (!userRes.ok) {
        const errData = await userRes.json().catch(() => ({}));
        throw new Error(`Token verification failed (HTTP ${userRes.status}: ${errData.message || userRes.statusText})`);
      }
      const userData = await userRes.json();

      // 2. Verify repository access on lianhangluah/hkhangluah
      const repoRes = await fetch(`https://api.github.com/repos/${GH_REPO_OWNER}/${GH_REPO_NAME}`, {
        headers: { "Authorization": `${authScheme} ${token}`, "Accept": "application/vnd.github.v3+json" }
      });

      if (!repoRes.ok) {
        const repoErr = await repoRes.json().catch(() => ({}));
        throw new Error(
          `Token belongs to @${userData.login}, but CANNOT access repository "${GH_REPO_OWNER}/${GH_REPO_NAME}" (HTTP ${repoRes.status}: ${repoErr.message || repoRes.statusText}).\n\n` +
          `Why this happens:\n` +
          `1. If using GitHub App (Ov23liELdAzmQwnCaqaO):\n` +
          `   - Open GitHub Settings -> Developer settings -> GitHub Apps -> click your app.\n` +
          `   - Go to "Permissions & events" -> "Repository permissions" -> set "Contents" to "Read & write".\n` +
          `   - Go to "Install App" in the left sidebar -> click "Install" on lianhangluah for repository "hkhangluah".\n\n` +
          `2. Alternatively (Instant fix):\n` +
          `   - Create a Personal Access Token on GitHub with "repo" scope.\n` +
          `   - Paste it in Site Settings -> Personal Access Token and click "Save & Verify".`
        );
      }

      const repoData = await repoRes.json();
      const hasPush = repoData.permissions?.push;

      if (!hasPush) {
        throw new Error(
          `Connected to ${repoData.full_name}, but token only has READ access (permissions.push is false).\n\n` +
          `Please grant write permission to the app or provide a Personal Access Token with repo/write scope.`
        );
      }

      alert(
        `GitHub Connection Verified!\n\n` +
        `User: @${userData.login}\n` +
        `Repository: ${repoData.full_name}\n` +
        `Write / Push Access: YES\n` +
        `Default Branch: ${repoData.default_branch}\n\n` +
        `Your CMS is fully configured and ready to publish live updates directly to GitHub.`
      );
      showToast("GitHub write access verified!");
    } catch (err) {
      alert(`GitHub Test Result:\n\n${err.message}`);
    }
  }

  document.getElementById('btn-test-conn')?.addEventListener('click', testGitHubConnection);
  document.getElementById('btn-settings-test-gh')?.addEventListener('click', testGitHubConnection);

  document.getElementById('btn-save-gh-token')?.addEventListener('click', async () => {
    const input = document.getElementById('cfg-gh-token-input');
