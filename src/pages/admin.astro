      <div class="bg-[var(--bg-primary)] border border-[var(--border-color)] rounded-2xl p-6 max-w-md w-full shadow-2xl space-y-4">
        <h3 class="text-base font-bold text-[var(--text-primary)]">Delete Post from Site?</h3>
        <p class="text-xs text-[var(--text-secondary)] leading-relaxed">
          You are about to delete <span id="del-modal-title" class="font-bold text-[var(--text-primary)]"></span>.
        </p>

        <div class="p-3.5 rounded-xl bg-[var(--bg-secondary)] border border-[var(--border-color)] text-xs font-mono space-y-1.5 text-[var(--text-secondary)]">
          <span class="text-[10px] font-bold uppercase tracking-wider block text-[var(--accent)]">Local Removal Command:</span>
          <code id="del-modal-command" class="block text-rose-500 font-bold select-all">rm src/content/posts/slug.md</code>
        </div>

        <div class="flex items-center justify-end gap-2 pt-2">
          <button
            type="button"
            id="del-modal-cancel"
            class="px-4 py-2 rounded-xl border border-[var(--border-color)] text-xs text-[var(--text-secondary)] hover:text-[var(--text-primary)] cursor-pointer"
          >
            Cancel
          </button>
          <button
            type="button"
            id="del-modal-confirm"
            class="px-4 py-2 rounded-xl bg-rose-600 text-white font-semibold text-xs hover:bg-rose-700 cursor-pointer"
          >
            Hide from Catalog
          </button>
        </div>
      </div>
    </div>

    <!-- Toast Feedback Notification -->
    <div
      id="cms-toast"
      class="fixed top-5 right-5 z-50 transform translate-y-[-100px] opacity-0 transition-all duration-300 pointer-events-none px-4 py-3 rounded-xl bg-[var(--text-primary)] text-[var(--bg-primary)] text-xs font-semibold shadow-xl flex items-center gap-2"
    >
      <span id="cms-toast-msg">Saved!</span>
    </div>

  </div>
</BaseLayout>

<script is:inline define:vars={{ existingPostsData, PRESET_TIPS, PRESET_THEMES, siteConfig, defaultSiteConfig }}>
  let currentType = "poem";
  let existingPosts = existingPostsData || [];
  let currentTipClass = "bg-purple-500";
  let currentTipName = "Purple";
  let currentThemeClass = "from-slate-950 via-purple-950 to-stone-950 text-purple-100";
  let currentThemeName = "Poetic Violet";

  // DOM Elements
  const titleInput = document.getElementById('post-title');
  const slugInput = document.getElementById('post-slug');
  const subtitleInput = document.getElementById('post-subtitle');
  const categoryInput = document.getElementById('post-category');
  const dateInput = document.getElementById('post-date');
  const readingTimeInput = document.getElementById('post-reading-time');
  const tagsInput = document.getElementById('post-tags');
  const coverInput = document.getElementById('post-cover');
  const bodyInput = document.getElementById('post-body');
  const imageFileInput = document.getElementById('image-file-input');

  // Tip Color & Theme Switchers
  function setTipColor(cls, name) {
    if (!cls) return;
    currentTipClass = cls;
    if (!name) {
      const found = PRESET_TIPS.find(t => t.accentBarClass === cls);
      name = found ? found.name : "Custom";
    }
    currentTipName = name;

    const hiddenTip = document.getElementById('post-tip-class');
    if (hiddenTip) hiddenTip.value = cls;

    const label = document.getElementById('label-selected-tip');
    if (label) label.textContent = name;

    // Update swatches ring
    document.querySelectorAll('.tip-swatch-btn').forEach(btn => {
      if (btn.dataset.tipClass === cls) {
        btn.classList.add('ring-2', 'ring-[var(--accent)]', 'border-transparent', 'font-bold');
      } else {
        btn.classList.remove('ring-2', 'ring-[var(--accent)]', 'border-transparent', 'font-bold');
      }
    });

    // Update mini card & full card tip spines
    const miniTip = document.getElementById('mini-card-tip');
    if (miniTip) {
      miniTip.className = `absolute top-0 left-0 right-0 h-1.5 transition-colors duration-300 ${cls}`;
    }
    const fullTip = document.getElementById('full-card-tip');
    if (fullTip) {
      fullTip.className = `absolute top-0 left-0 right-0 h-1.5 transition-colors duration-300 ${cls}`;
    }
  }

  function setThemeClass(cls, name) {
    if (!cls) return;
    currentThemeClass = cls;
    if (!name) {
      const found = PRESET_THEMES.find(t => t.themeClass === cls);
      name = found ? found.name : "Custom";
    }
    currentThemeName = name;

    const hiddenTheme = document.getElementById('post-theme-class');
    if (hiddenTheme) hiddenTheme.value = cls;

    const label = document.getElementById('label-selected-theme');
    if (label) label.textContent = name;

    // Update tiles ring
    document.querySelectorAll('.theme-tile-btn').forEach(btn => {
      if (btn.dataset.themeClass === cls) {
        btn.classList.add('ring-2', 'ring-[var(--accent)]', 'border-transparent');
        btn.classList.remove('border-stone-800');
      } else {
        btn.classList.remove('ring-2', 'ring-[var(--accent)]', 'border-transparent');
        btn.classList.add('border-stone-800');
      }
    });

    // Update mini card & full card background gradients
    const miniCard = document.getElementById('mini-card-preview');
    if (miniCard) {
      miniCard.className = `w-full relative flex flex-col justify-between overflow-hidden rounded-xl border border-stone-800 p-4 select-none bg-gradient-to-br ${cls} aspect-video shadow-md transition-all duration-300`;
    }
    const fullCard = document.getElementById('full-card-preview');
    if (fullCard) {
      fullCard.className = `relative flex flex-col justify-between overflow-hidden rounded-xl border border-stone-800 p-5 select-none bg-gradient-to-br ${cls} aspect-video shadow-md transition-all duration-300`;
    }
  }

  // Bind Swatch & Tile Clicks
  document.querySelectorAll('.tip-swatch-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      setTipColor(btn.dataset.tipClass, btn.dataset.tipName);
      showToast(`Tip color: ${btn.dataset.tipName}`);
    });
  });

  document.querySelectorAll('.theme-tile-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      setThemeClass(btn.dataset.themeClass, btn.dataset.themeName);
      showToast(`Card theme: ${btn.dataset.themeName}`);
    });
  });

  // Simple, rock-solid client-side Markdown parser for live preview
  function renderMarkdown(md) {
    if (!md) return '<p class="text-[var(--text-secondary)] italic">Start typing in the composer to view rendered markdown preview...</p>';

    // Escape raw HTML entities
    let html = md
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');

    // Headings
    html = html.replace(/^### (.*$)/gim, '<h3 class="text-lg font-bold font-sans tracking-tight text-[var(--text-primary)] mt-4 mb-1">$1</h3>');
    html = html.replace(/^## (.*$)/gim, '<h2 class="text-xl font-bold font-sans tracking-tight text-[var(--text-primary)] mt-6 mb-2 border-b border-[var(--border-color)]/60 pb-1">$1</h2>');
    html = html.replace(/^# (.*$)/gim, '<h1 class="text-2xl font-bold font-sans tracking-tight text-[var(--text-primary)] mt-6 mb-2">$1</h1>');

    // Horizontal Rule / Stanza Divider
    html = html.replace(/^---$/gim, '<hr class="my-6 border-[var(--border-color)]" />');

    // Images: ![alt](url)
    html = html.replace(/!\[(.*?)\]\((.*?)\)/gim, '<div class="my-4 rounded-xl overflow-hidden border border-[var(--border-color)]"><img src="$2" alt="$1" class="w-full object-cover max-h-80" /><span class="block p-2 text-center text-xs text-[var(--text-secondary)] font-sans italic">$1</span></div>');

    // Links: [text](url)
    html = html.replace(/\[(.*?)\]\((.*?)\)/gim, '<a href="$2" class="text-[var(--accent)] underline underline-offset-2">$1</a>');

    // Bold & Italics
    html = html.replace(/\*\*(.*?)\*\*/gim, '<strong>$1</strong>');
    html = html.replace(/\*(.*?)\*/gim, '<em>$1</em>');

    // Blockquotes: > quote
    html = html.replace(/^> (.*$)/gim, '<blockquote class="p-3.5 my-3 rounded-xl bg-[var(--bg-secondary)]/60 border-l-4 border-[var(--accent)] font-serif italic text-sm text-[var(--text-primary)] leading-relaxed">$1</blockquote>');

    // Paragraphs / Stanzas (split on double newlines)
    const blocks = html.split(/\n\s*\n/);
    return blocks.map(block => {
      block = block.trim();
      if (!block) return '';
      if (block.startsWith('<h') || block.startsWith('<blockquote') || block.startsWith('<div') || block.startsWith('<hr')) {
        return block;
      }
      return `<p class="whitespace-pre-line text-base font-serif leading-relaxed text-[var(--text-primary)]">${block}</p>`;
    }).join('\n');
  }

  // Live Preview update
  function updateLivePreview() {
    const title = titleInput.value.trim() || "Untitled Publication";
    const subtitle = subtitleInput.value.trim() || "Overview / subtitle preview";
    const category = categoryInput.value.trim() || "Poetry";
    const date = dateInput.value.trim() || "October 2026";
    const readingTime = readingTimeInput.value.trim() || "3 min read";
    const body = bodyInput.value.trim();
    const coverUrl = coverInput.value.trim();
    const tags = tagsInput.value.split(',').map(t => t.trim()).filter(Boolean);

    // Article View
    document.getElementById('prev-title').textContent = title;
    document.getElementById('prev-subtitle').textContent = subtitle;
    document.getElementById('prev-category-badge').textContent = category;
    document.getElementById('prev-date').textContent = date;
    document.getElementById('prev-reading-time').textContent = readingTime;

    // Cover image preview
    const coverContainer = document.getElementById('prev-cover-container');
    const coverImg = document.getElementById('prev-cover-img');
    if (coverUrl) {
      coverImg.src = coverUrl;
      coverContainer.classList.remove('hidden');
    } else {
      coverContainer.classList.add('hidden');
    }

    // Rendered markdown body
    document.getElementById('prev-markdown-rendered').innerHTML = renderMarkdown(body);

    // Tags
    const tagsContainer = document.getElementById('prev-tags-container');
    tagsContainer.innerHTML = tags.map(t => `<span>#${t.toLowerCase()}</span>`).join(' &bull; ');

    // Sync Cards (Mini in editor & Full in Live Preview Tab)
    const journalVal = document.getElementById('paper-journal')?.value.trim();
    const headerLabel = currentType === 'academic_paper'
      ? (journalVal ? journalVal.slice(0, 24).toUpperCase() : 'ACADEMIC MONOGRAPH')
      : (currentType === 'poem' ? 'POETRY MONOGRAPH' : 'ESSAY & REFLECTION');
    const subcategory = category.toUpperCase();
    const yearDigits = date.replace(/\D/g, '');
    const yearStr = (yearDigits && yearDigits.length >= 4) ? yearDigits.slice(-4) : "2026";
    const langBadge = currentType === 'poem' ? "English Verse" : "Simte / English";

    // Mini card simulation in Write tab
    const miniHeader = document.getElementById('mini-card-header');
    if (miniHeader) miniHeader.textContent = headerLabel;
    const miniYear = document.getElementById('mini-card-year');
    if (miniYear) miniYear.textContent = yearStr;
    const miniSubcat = document.getElementById('mini-card-subcat');
    if (miniSubcat) miniSubcat.textContent = subcategory;
    const miniTitle = document.getElementById('mini-card-title');
    if (miniTitle) miniTitle.textContent = title;
    const miniSub = document.getElementById('mini-card-subtitle');
    if (miniSub) miniSub.textContent = subtitle || readingTime;
    const miniLang = document.getElementById('mini-card-lang');
    if (miniLang) miniLang.textContent = langBadge;

    // Full card preview in Live Preview tab
    const fullHeader = document.getElementById('full-card-header');
    if (fullHeader) fullHeader.textContent = headerLabel;
    const fullYear = document.getElementById('full-card-year');
    if (fullYear) fullYear.textContent = yearStr;
    const fullSubcat = document.getElementById('full-card-subcat');
    if (fullSubcat) fullSubcat.textContent = subcategory;
    const fullTitle = document.getElementById('full-card-title');
    if (fullTitle) fullTitle.textContent = title;
    const fullSub = document.getElementById('full-card-subtitle');
    if (fullSub) fullSub.textContent = subtitle || readingTime;
    const fullLang = document.getElementById('full-card-lang');
    if (fullLang) fullLang.textContent = langBadge;
  }

  // Live input listeners
  [titleInput, subtitleInput, categoryInput, dateInput, readingTimeInput, tagsInput, coverInput, bodyInput].forEach(el => {
    el?.addEventListener('input', updateLivePreview);
  });

  [
    'paper-journal', 'paper-volume', 'paper-issn', 'paper-doi', 'paper-authors', 'paper-lang', 'paper-subdiscipline', 'paper-abstract',
    'poem-form-input', 'poem-theme-input', 'poem-lang-input', 'poem-couplet-input', 'poem-reflection-input',
    'essay-location-input', 'essay-topic-input', 'essay-pullquote-input', 'essay-quote-author'
  ].forEach(id => {
    document.getElementById(id)?.addEventListener('input', updateLivePreview);
  });

  // Tab switching logic
  function switchTab(targetId) {
    document.querySelectorAll('.tab-panel').forEach(panel => panel.classList.add('hidden'));
    const activePanel = document.getElementById(targetId);
    if (activePanel) activePanel.classList.remove('hidden');

    document.querySelectorAll('.nav-tab-btn').forEach(btn => {
      if (btn.dataset.target === targetId) {
        btn.classList.add('bg-[var(--text-primary)]', 'text-[var(--bg-primary)]', 'font-semibold');
        btn.classList.remove('text-[var(--text-secondary)]');
      } else {
        btn.classList.remove('bg-[var(--text-primary)]', 'text-[var(--bg-primary)]', 'font-semibold');
        btn.classList.add('text-[var(--text-secondary)]');
      }
    });

    document.querySelectorAll('.mobile-dock-btn').forEach(btn => {
      if (btn.dataset.target === targetId) {
        btn.classList.add('text-[var(--accent)]', 'font-semibold');
        btn.classList.remove('text-[var(--text-secondary)]');
      } else {
        btn.classList.remove('text-[var(--accent)]', 'font-semibold');
        btn.classList.add('text-[var(--text-secondary)]');
      }
    });

    if (targetId === 'tab-preview') updateLivePreview();
    if (targetId === 'tab-code') generateCode();
    if (targetId === 'tab-drafts') renderDrafts();
    if (targetId === 'tab-site-config') updateSiteConfigCodeOutput();
  }

  document.querySelectorAll('.nav-tab-btn, .mobile-dock-btn, [data-target]').forEach(el => {
    el.addEventListener('click', () => {
      const target = el.dataset.target;
      if (target) switchTab(target);
    });
  });

  // Type selection logic
  document.querySelectorAll('.type-pill-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.type-pill-btn').forEach(b => {
        b.classList.remove('bg-[var(--text-primary)]', 'text-[var(--bg-primary)]', 'font-semibold');
        b.classList.add('bg-[var(--bg-primary)]', 'text-[var(--text-secondary)]');
      });
      btn.classList.add('bg-[var(--text-primary)]', 'text-[var(--bg-primary)]', 'font-semibold');
      btn.classList.remove('bg-[var(--bg-primary)]', 'text-[var(--text-secondary)]');
      
      currentType = btn.dataset.type;
      
      const poemFields = document.getElementById('section-poem-fields');
      const essayFields = document.getElementById('section-essay-fields');
      const paperFields = document.getElementById('section-paper-fields');
      const composerLabel = document.getElementById('composer-label');

      if (currentType === 'poem') {
        poemFields?.classList.remove('hidden');
        essayFields?.classList.add('hidden');
        paperFields?.classList.add('hidden');
        if (composerLabel) composerLabel.textContent = "Verses & Stanzas Composer";
        bodyInput.placeholder = "Write your verses, couplets, or stanzas here. Use double line-breaks to separate stanzas.";
        titleInput.placeholder = "e.g. Whispers Along the River Plain";
        subtitleInput.placeholder = "A lyrical poem of twilight mist, flowing water, and quiet valleys";
        categoryInput.value = "Poetry & Literature";
        readingTimeInput.value = "3 min read";
        setTipColor("bg-purple-500", "Purple");
        setThemeClass("from-slate-950 via-purple-950 to-stone-950 text-purple-100", "Poetic Violet");
      } else if (currentType === 'essay') {
        poemFields?.classList.add('hidden');
        essayFields?.classList.remove('hidden');
        paperFields?.classList.add('hidden');
        if (composerLabel) composerLabel.textContent = "Essay Body (Markdown Composer)";
        bodyInput.placeholder = "Write your essay in Markdown with section headings (##), reflections, and blockquotes.";
        titleInput.placeholder = "e.g. Language as a Repository of Lived Experience";
        subtitleInput.placeholder = "Why grammatical documentation must encompass folklore and cultural memory";
        categoryInput.value = "Cultural Dispatches";
        readingTimeInput.value = "5 min read";
        setTipColor("bg-amber-500", "Amber");
        setThemeClass("from-amber-950 via-stone-900 to-amber-950 text-amber-100", "Autumn Amber");
      } else if (currentType === 'academic_paper') {
        poemFields?.classList.add('hidden');
        essayFields?.classList.add('hidden');
        paperFields?.classList.remove('hidden');
        if (composerLabel) composerLabel.textContent = "Monograph Body & Linguistic Analysis";
        bodyInput.placeholder = "Write or paste your academic monograph sections, numbered linguistic examples, and references.";
        titleInput.placeholder = "e.g. Pronouns in Simte";
        subtitleInput.placeholder = "A morphological and syntactic investigation of pronominal forms and clusivity";
        categoryInput.value = "Linguistic Research";
        readingTimeInput.value = "12 min read";
        setTipColor("bg-indigo-500", "Indigo");
        setThemeClass("from-slate-900 via-slate-800 to-indigo-950 text-slate-100", "Scholarly Indigo");
      }
      updateLivePreview();
    });
  });

  // Auto-slug generator
  titleInput?.addEventListener('input', () => {
    if (!slugInput.dataset.manuallyEdited) {
      slugInput.value = titleInput.value
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-|-$/g, '');
    }
  });
  slugInput?.addEventListener('input', () => {
    slugInput.dataset.manuallyEdited = "true";
  });

  // Markdown Toolbar actions
  function wrapSelection(before, after = before) {
    const start = bodyInput.selectionStart;
    const end = bodyInput.selectionEnd;
    const text = bodyInput.value;
    const selected = text.substring(start, end) || "text";
    bodyInput.value = text.substring(0, start) + before + selected + after + text.substring(end);
    bodyInput.focus();
    bodyInput.setSelectionRange(start + before.length, start + before.length + selected.length);
    updateLivePreview();
  }

  function insertLinePrefix(prefix) {
    const start = bodyInput.selectionStart;
    const text = bodyInput.value;
    const lineStart = text.lastIndexOf('\n', start - 1) + 1;
    bodyInput.value = text.substring(0, lineStart) + prefix + text.substring(lineStart);
    bodyInput.focus();
    updateLivePreview();
  }

  document.querySelectorAll('.md-tool-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const syntax = btn.dataset.syntax;
      const action = btn.dataset.action;

      if (syntax) {
        wrapSelection(syntax);
      } else if (action === 'h2') {
        insertLinePrefix('## ');
      } else if (action === 'h3') {
        insertLinePrefix('### ');
      } else if (action === 'quote') {
        insertLinePrefix('> ');
      } else if (action === 'list') {
        insertLinePrefix('- ');
      } else if (action === 'divider') {
        wrapSelection('\n\n---\n\n', '');
      } else if (action === 'image') {
        const url = prompt("Enter Image URL:", "https://");
        if (url) {
          const caption = prompt("Enter Image Caption:", "Photo Description") || "Photo";
          wrapSelection(`![${caption}](${url})\n`, '');
        }
      }
    });
  });

  // Device Image file picker
  imageFileInput?.addEventListener('change', (e) => {
    const file = e.target.files?.[0];
    if (file) {
      const reader = new FileReader();
      reader.onload = (event) => {
        const dataUrl = event.target?.result;
        coverInput.value = dataUrl;
        document.getElementById('image-preview-thumb').src = dataUrl;
        document.getElementById('image-preview-name').textContent = file.name;
        document.getElementById('image-preview-box').classList.remove('hidden');
        document.getElementById('image-preview-box').classList.add('flex');
        updateLivePreview();
        showToast("Image selected");
      };
      reader.readAsDataURL(file);
    }
  });

  document.getElementById('btn-remove-image')?.addEventListener('click', () => {
    coverInput.value = '';
    imageFileInput.value = '';
    document.getElementById('image-preview-box').classList.add('hidden');
    document.getElementById('image-preview-box').classList.remove('flex');
    updateLivePreview();
    showToast("Image removed");
  });

  // Toast utility
  function showToast(msg) {
    const toast = document.getElementById('cms-toast');
    const toastMsg = document.getElementById('cms-toast-msg');
    toastMsg.textContent = msg;
    toast.classList.remove('translate-y-[-100px]', 'opacity-0');
    toast.classList.add('translate-y-0', 'opacity-100');
    setTimeout(() => {
      toast.classList.add('translate-y-[-100px]', 'opacity-0');
      toast.classList.remove('translate-y-0', 'opacity-100');
    }, 2500);
  }

  // Generate Markdown file utility
  function generateCode() {
    const title = titleInput.value.trim() || "Untitled Publication";
    const slug = slugInput.value.trim() || "untitled-publication";
    const subtitle = subtitleInput.value.trim();
    const category = categoryInput.value.trim() || (currentType === 'poem' ? "Poetry & Literature" : (currentType === 'academic_paper' ? "Linguistic Research" : "Indigenous Knowledge"));
    const date = dateInput.value.trim() || "October 2026";
    const yearDigits = date.replace(/\D/g, '');
    const year = parseInt(yearDigits && yearDigits.length >= 4 ? yearDigits.slice(-4) : "2026") || 2026;
    const readingTime = readingTimeInput.value.trim() || "3 min read";
    const coverImage = coverInput.value.trim() || "https://placehold.co/800x450/1c1917/ffffff?text=Publication";
    const body = bodyInput.value.trim();
    const tags = tagsInput.value.split(',').map(t => t.trim()).filter(Boolean);

    let md = `---\n`;
    md += `title: ${JSON.stringify(title)}\n`;
    md += `slug: ${JSON.stringify(slug)}\n`;
    if (subtitle) md += `subtitle: ${JSON.stringify(subtitle)}\n`;
    md += `excerpt: ${JSON.stringify(subtitle || title)}\n`;
    md += `date: ${JSON.stringify(date)}\n`;
    md += `year: ${year}\n`;
    md += `readingTime: ${JSON.stringify(readingTime)}\n`;
    md += `category: ${JSON.stringify(category)}\n`;
    md += `postType: ${JSON.stringify(currentType)}\n`;
    md += `authors: "H. Kapginlian"\n`;

    if (currentType === 'poem') {
      const poemLang = document.getElementById('poem-lang-input')?.value.trim() || "English Verse";
      const poemReflection = document.getElementById('poem-reflection-input')?.value.trim();
      const poemCouplet = document.getElementById('poem-couplet-input')?.value.trim();
      md += `language: "English"\n`;
      md += `languageFamily: ${JSON.stringify(poemLang)}\n`;
      md += `articleLanguage: "English"\n`;
      if (poemReflection) md += `abstract: ${JSON.stringify(poemReflection)}\n`;
      if (poemCouplet) {
        md += `featuredCouplet: |\n${poemCouplet.split('\n').map(l => `  ${l}`).join('\n')}\n`;
      }
    } else if (currentType === 'essay') {
      const essayTopic = document.getElementById('essay-topic-input')?.value.trim() || "Indigenous Knowledge";
      const essayPullquote = document.getElementById('essay-pullquote-input')?.value.trim();
      md += `language: "Simte"\n`;
      md += `languageFamily: "Tibeto-Burman"\n`;
      md += `articleLanguage: "English"\n`;
      if (essayPullquote) {
        md += `featuredCouplet: |\n${essayPullquote.split('\n').map(l => `  ${l}`).join('\n')}\n`;
      }
    } else if (currentType === 'academic_paper') {
      const journal = document.getElementById('paper-journal')?.value.trim();
      const volume = document.getElementById('paper-volume')?.value.trim();
      const issn = document.getElementById('paper-issn')?.value.trim();
      const doi = document.getElementById('paper-doi')?.value.trim();
      const paperLang = document.getElementById('paper-lang')?.value.trim() || "Simte";
      const abstract = document.getElementById('paper-abstract')?.value.trim();
      md += `language: ${JSON.stringify(paperLang)}\n`;
      md += `languageFamily: "Tibeto-Burman"\n`;
      md += `articleLanguage: "English"\n`;
      if (journal) md += `journal: ${JSON.stringify(journal)}\n`;
      if (volume) md += `volume: ${JSON.stringify(volume)}\n`;
      if (issn) md += `issn: ${JSON.stringify(issn)}\n`;
      if (doi) md += `doi: ${JSON.stringify(doi)}\n`;
      if (abstract) md += `abstract: ${JSON.stringify(abstract)}\n`;
    }

    if (currentThemeClass) md += `themeClass: ${JSON.stringify(currentThemeClass)}\n`;
    if (currentTipClass) md += `accentBarClass: ${JSON.stringify(currentTipClass)}\n`;
    md += `coverImage: ${JSON.stringify(coverImage)}\n`;
    md += `featured: false\n`;

    if (tags.length > 0) {
      md += `tags:\n`;
      tags.forEach(t => {
        md += `  - ${JSON.stringify(t)}\n`;
      });
    }

    md += `---\n\n`;
    md += body ? body : `<!-- Verses or content -->\n`;

    document.getElementById('code-output').querySelector('code').textContent = md;
    const targetPath = currentType === 'academic_paper' ? `src/data/posts/${slug}.ts` : `src/content/posts/${slug}.md`;
    document.getElementById('target-filename-label').textContent = targetPath;
  }

  // Render published item into the catalog list DOM
  function renderPublishedItemToCatalog(post) {
    const listContainer = document.getElementById('existing-posts-list');
    if (!listContainer) return;
    let itemEl = listContainer.querySelector(`.catalog-item[data-slug="${post.slug}"]`);
    if (!itemEl) {
      itemEl = document.createElement('div');
      itemEl.className = 'catalog-item p-4 rounded-xl border border-emerald-500/40 bg-emerald-500/5 hover:border-emerald-500 transition-colors flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs';
      itemEl.dataset.slug = post.slug;
      itemEl.dataset.title = post.title;
      listContainer.prepend(itemEl);
    }
    const typeLabel = (post.postType || "poem").replace("_", " ");
    const typeClass = post.postType === "poem" ? "bg-purple-500/10 text-purple-600 dark:text-purple-400" :
      post.postType === "academic_paper" ? "bg-blue-500/10 text-blue-600 dark:text-blue-400" :
      "bg-amber-500/10 text-amber-600 dark:text-amber-400";
    const filePath = post.postType === "academic_paper" ? `src/data/posts/${post.slug}.ts` : `src/content/posts/${post.slug}.md`;
    itemEl.innerHTML = `
      <div class="space-y-1">
        <div class="flex items-center gap-2 font-mono text-[10px]">
          <span class="px-2 py-0.5 rounded font-bold uppercase bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">
            Published
          </span>
          <span class="px-2 py-0.5 rounded font-bold uppercase ${typeClass}">
            ${typeLabel}
          </span>
          <span class="text-[var(--text-secondary)]">${post.date || 'Oct 2026'}</span>
        </div>
        <h3 class="font-bold font-sans text-sm text-[var(--text-primary)] line-clamp-1">${post.title}</h3>
        <span class="font-mono text-[11px] text-[var(--text-secondary)]">${filePath}</span>
      </div>
      <div class="flex items-center gap-2 shrink-0">
        <button
          type="button"
          class="btn-load-existing px-3 py-1.5 rounded-lg bg-[var(--bg-secondary)] hover:bg-[var(--accent-light)] text-[var(--text-primary)] font-semibold transition-colors min-h-[36px] cursor-pointer"
          data-slug="${post.slug}"
        >
          Edit
        </button>
        <button
          type="button"
          class="btn-delete-post px-3 py-1.5 rounded-lg border border-rose-300 dark:border-rose-900/60 text-rose-600 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-950/30 transition-colors min-h-[36px] cursor-pointer"
          data-slug="${post.slug}"
          data-title="${post.title}"
        >
          Delete
        </button>
      </div>
    `;

    itemEl.querySelector('.btn-load-existing')?.addEventListener('click', () => {
      const found = existingPosts.find(p => p.slug === post.slug);
      if (found) loadIntoForm(found);
    });

    itemEl.querySelector('.btn-delete-post')?.addEventListener('click', () => {
      postToDelete = {
        slug: post.slug,
        title: post.title,
        postType: post.postType
      };
      delModalTitle.textContent = `"${post.title}"`;
      delModalCommand.textContent = `rm ${filePath}`;
      deleteModal.classList.remove('hidden');
    });
  }

  // Publish Post Handler
  function publishCurrentPost() {
    const title = titleInput.value.trim();
    if (!title) {
      showToast("Please enter a title before publishing");
      titleInput.focus();
      return;
    }

    generateCode();
    const slug = slugInput.value.trim() || title.toLowerCase().replace(/[^a-z0-9]+/g, '-');
    const category = categoryInput.value.trim() || (currentType === 'poem' ? 'Poetry & Literature' : (currentType === 'academic_paper' ? 'Linguistic Research' : 'Cultural Dispatches'));
    const date = dateInput.value.trim() || new Date().toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
    const readingTime = readingTimeInput.value.trim() || '3 min read';
    const body = bodyInput.value;
    const coverImage = coverInput.value.trim();
    const tags = tagsInput.value.split(',').map(t => t.trim()).filter(Boolean);

    const postItem = {
      slug,
      title,
      subtitle: subtitleInput.value.trim(),
      category,
      date,
      year: parseInt(date.replace(/\D/g, '').slice(-4)) || 2026,
      readingTime,
      tags,
      coverImage,
      body,
      postType: currentType,
      themeClass: currentThemeClass,
      accentBarClass: currentTipClass,
      isPublished: true,
      publishedAt: new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }),
    };

    // Store in localStorage published posts
    try {
      const stored = JSON.parse(localStorage.getItem('hk_cms_published_posts') || '[]');
      const existIdx = stored.findIndex(p => p.slug === slug);
      if (existIdx >= 0) stored[existIdx] = postItem;
      else stored.unshift(postItem);
      localStorage.setItem('hk_cms_published_posts', JSON.stringify(stored));
    } catch (e) {
      console.error(e);
    }

    // Add or update in active memory catalog
    const catIdx = existingPosts.findIndex(p => p.slug === slug);
    if (catIdx >= 0) {
      existingPosts[catIdx] = postItem;
    } else {
      existingPosts.unshift(postItem);
    }
    const catBadge = document.getElementById('catalog-count-badge');
    if (catBadge) catBadge.textContent = existingPosts.length;

    // Render immediately into catalog DOM
    renderPublishedItemToCatalog(postItem);

    // Show publish success modal
    const pubModal = document.getElementById('publish-modal');
    if (pubModal) {
      const targetFile = currentType === 'academic_paper' ? `src/data/posts/${slug}.ts` : `src/content/posts/${slug}.md`;
      document.getElementById('pub-modal-title').textContent = `"${title}"`;
      document.getElementById('pub-modal-filename').textContent = targetFile;
      pubModal.classList.remove('hidden');
    }

    showToast(`Published "${title}" to catalog!`);
  }

  // Publish button triggers
  document.getElementById('btn-publish-post')?.addEventListener('click', publishCurrentPost);
  document.getElementById('btn-publish-top')?.addEventListener('click', publishCurrentPost);
  document.getElementById('btn-goto-preview')?.addEventListener('click', () => switchTab('tab-preview'));

  // Publish Modal handlers
  document.getElementById('pub-modal-close')?.addEventListener('click', () => {
    document.getElementById('publish-modal')?.classList.add('hidden');
  });

  document.getElementById('pub-modal-copy-code')?.addEventListener('click', () => {
    const code = document.getElementById('code-output').querySelector('code').textContent;
    navigator.clipboard.writeText(code).then(() => showToast("Markdown copied!"));
  });

  document.getElementById('pub-modal-view-catalog')?.addEventListener('click', () => {
    document.getElementById('publish-modal')?.classList.add('hidden');
    switchTab('tab-existing');
  });

  // Copy code button in tab-code
  document.getElementById('btn-copy-code')?.addEventListener('click', () => {
    const code = document.getElementById('code-output').querySelector('code').textContent;
    navigator.clipboard.writeText(code).then(() => showToast("Markdown copied to clipboard!"));
  });

  // Download file button in tab-code
  document.getElementById('btn-download-file')?.addEventListener('click', () => {
    const slug = slugInput.value.trim() || "new-post";
    const code = document.getElementById('code-output').querySelector('code').textContent;
    const ext = currentType === 'academic_paper' ? 'ts' : 'md';
    const mime = currentType === 'academic_paper' ? 'text/typescript;charset=utf-8' : 'text/markdown;charset=utf-8';
    const blob = new Blob([code], { type: mime });
    const link = document.createElement("a");
    link.href = URL.createObjectURL(blob);
    link.download = `${slug}.${ext}`;
    link.click();
    URL.revokeObjectURL(link.href);
    showToast(`Downloaded ${slug}.${ext}`);
  });

  // Drafts Management (LocalStorage)
  function getDrafts() {
    try {
      return JSON.parse(localStorage.getItem('hk_cms_drafts') || "[]");
    } catch {
      return [];
    }
  }

  function saveCurrentDraft() {
    const title = titleInput.value.trim();
    if (!title) {
      showToast("Enter a title before saving draft");
      return;
    }

    const draft = {
      id: Date.now(),
      savedAt: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
      title,
      slug: slugInput.value.trim(),
      subtitle: subtitleInput.value,
      category: categoryInput.value,
      date: dateInput.value,
      readingTime: readingTimeInput.value,
      tags: tagsInput.value,
      coverImage: coverInput.value,
      body: bodyInput.value,
      type: currentType,
      themeClass: currentThemeClass,
      accentBarClass: currentTipClass,
      featuredCouplet: document.getElementById('poem-couplet-input')?.value || "",
      abstract: document.getElementById('paper-abstract')?.value || document.getElementById('poem-reflection-input')?.value || "",
      pullQuote: document.getElementById('essay-pullquote-input')?.value || "",
      journal: document.getElementById('paper-journal')?.value || "",
      volume: document.getElementById('paper-volume')?.value || "",
      doi: document.getElementById('paper-doi')?.value || "",
      issn: document.getElementById('paper-issn')?.value || "",
      authors: document.getElementById('paper-authors')?.value || "",
    };

    const drafts = getDrafts();
    const existingIndex = drafts.findIndex(d => d.slug === draft.slug);
    if (existingIndex >= 0) {
      drafts[existingIndex] = draft;
    } else {
      drafts.unshift(draft);
    }
    localStorage.setItem('hk_cms_drafts', JSON.stringify(drafts));
    updateDraftsBadge();
    showToast("Draft saved locally!");
  }

  document.getElementById('btn-save-draft')?.addEventListener('click', saveCurrentDraft);

  function updateDraftsBadge() {
    const count = getDrafts().length;
    const badge = document.getElementById('drafts-count-badge');
    if (badge) badge.textContent = `(${count})`;
  }

  function renderDrafts() {
    const drafts = getDrafts();
    const container = document.getElementById('drafts-container');
    const noMsg = document.getElementById('no-drafts-msg');

    if (drafts.length === 0) {
      container.innerHTML = '';
      container.appendChild(noMsg);
      noMsg.classList.remove('hidden');
      return;
    }

    noMsg.classList.add('hidden');
    container.innerHTML = drafts.map(d => `
      <div class="p-4 rounded-xl border border-[var(--border-color)] bg-[var(--bg-primary)] flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs">
        <div class="space-y-1">
          <div class="flex items-center gap-2">
            <span class="px-2 py-0.5 rounded font-mono font-bold uppercase bg-[var(--accent-light)] text-[var(--accent)] text-[10px]">
              ${d.type}
            </span>
            <span class="text-[var(--text-secondary)] font-mono">Saved ${d.savedAt}</span>
          </div>
          <h3 class="font-bold text-sm text-[var(--text-primary)]">${d.title}</h3>
          <p class="text-[var(--text-secondary)] font-serif line-clamp-1">${d.subtitle || d.body || ""}</p>
        </div>
        <div class="flex items-center gap-2 shrink-0">
          <button type="button" class="btn-load-draft px-3 py-1.5 rounded-lg bg-[var(--text-primary)] text-[var(--bg-primary)] font-semibold cursor-pointer" data-id="${d.id}">
            Load Draft
          </button>
          <button type="button" class="btn-del-draft px-3 py-1.5 rounded-lg border border-[var(--border-color)] text-rose-500 hover:bg-rose-50 dark:hover:bg-rose-950/30 cursor-pointer" data-id="${d.id}">
            Delete
          </button>
        </div>
      </div>
    `).join('');

    container.querySelectorAll('.btn-load-draft').forEach(btn => {
      btn.addEventListener('click', () => {
        const d = drafts.find(x => x.id === parseInt(btn.dataset.id));
        if (d) loadIntoForm(d);
      });
    });

    container.querySelectorAll('.btn-del-draft').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = parseInt(btn.dataset.id);
        const filtered = drafts.filter(x => x.id !== id);
        localStorage.setItem('hk_cms_drafts', JSON.stringify(filtered));
        renderDrafts();
        updateDraftsBadge();
        showToast("Draft deleted");
      });
    });
  }

  function loadIntoForm(data) {
    titleInput.value = data.title || "";
    slugInput.value = data.slug || "";
    subtitleInput.value = data.subtitle || "";
    categoryInput.value = data.category || "Poetry";
    dateInput.value = data.date || "";
    readingTimeInput.value = data.readingTime || "3 min read";
    tagsInput.value = Array.isArray(data.tags) ? data.tags.join(', ') : (data.tags || "");
    coverInput.value = data.coverImage || "";
    bodyInput.value = data.body || "";

    if (data.type) {
      const typeBtn = document.querySelector(`.type-pill-btn[data-type="${data.type}"]`);
      typeBtn?.click();
    }

    if (data.type === 'poem') {
      const coupletInput = document.getElementById('poem-couplet-input');
      if (coupletInput) coupletInput.value = data.featuredCouplet || "";
      const reflInput = document.getElementById('poem-reflection-input');
      if (reflInput) reflInput.value = data.abstract || "";
      const formInput = document.getElementById('poem-form-input');
      if (formInput && data.formula) formInput.value = data.formula;
    } else if (data.type === 'essay') {
      const pullquoteInput = document.getElementById('essay-pullquote-input');
      if (pullquoteInput) pullquoteInput.value = data.pullQuote || "";
    } else if (data.type === 'academic_paper') {
      const journalInput = document.getElementById('paper-journal');
      if (journalInput) journalInput.value = data.journal || "";
      const volumeInput = document.getElementById('paper-volume');
      if (volumeInput) volumeInput.value = data.volume || "";
      const doiInput = document.getElementById('paper-doi');
      if (doiInput) doiInput.value = data.doi || "";
      const issnInput = document.getElementById('paper-issn');
      if (issnInput) issnInput.value = data.issn || "";
      const authorsInput = document.getElementById('paper-authors');
      if (authorsInput) authorsInput.value = data.authors || "";
      const abstractInput = document.getElementById('paper-abstract');
      if (abstractInput) abstractInput.value = data.abstract || "";
    }

    if (data.accentBarClass) {
      setTipColor(data.accentBarClass);
    } else {
      setTipColor("bg-purple-500", "Purple");
    }

    if (data.themeClass) {
      setThemeClass(data.themeClass);
    } else {
      setThemeClass("from-slate-950 via-purple-950 to-stone-950 text-purple-100", "Poetic Violet");
    }

    updateLivePreview();
    switchTab('tab-write');
    showToast(`Loaded "${data.title}"`);
  }

  // Load existing post button
  document.querySelectorAll('.btn-load-existing').forEach(btn => {
    btn.addEventListener('click', () => {
      const slug = btn.dataset.slug;
      const found = existingPosts.find(p => p.slug === slug);
      if (found) {
        loadIntoForm({
          title: found.title,
          slug: found.slug,
          subtitle: found.subtitle,
          category: found.category,
          date: found.date,
          readingTime: found.readingTime,
          tags: found.tags,
          coverImage: found.coverImage,
          body: found.body,
          type: found.postType,
          themeClass: found.themeClass,
          accentBarClass: found.accentBarClass,
          journal: found.journal,
          volume: found.volume,
          issn: found.issn,
          doi: found.doi,
          authors: found.authors,
          abstract: found.abstract,
          featuredCouplet: found.featuredCouplet,
          pullQuote: found.pullQuote,
          formula: found.formula,
        });
      }
    });
  });

  // Post Deletion Logic
  let postToDelete = null;
  const deleteModal = document.getElementById('delete-modal');
  const delModalTitle = document.getElementById('del-modal-title');
  const delModalCommand = document.getElementById('del-modal-command');
  const delModalCancel = document.getElementById('del-modal-cancel');
  const delModalConfirm = document.getElementById('del-modal-confirm');

  document.querySelectorAll('.btn-delete-post').forEach(btn => {
    btn.addEventListener('click', () => {
      const slug = btn.dataset.slug;
      const found = existingPosts.find(p => p.slug === slug);
      postToDelete = {
        slug: slug,
        title: btn.dataset.title,
        postType: found?.postType
      };
      const isAcademic = found?.postType === "academic_paper";
      const filePath = isAcademic ? `src/data/posts/${slug}.ts` : `src/content/posts/${slug}.md`;
      delModalTitle.textContent = `"${postToDelete.title}"`;
      delModalCommand.textContent = `rm ${filePath}`;
      deleteModal.classList.remove('hidden');
    });
  });

  delModalCancel?.addEventListener('click', () => {
    deleteModal.classList.add('hidden');
    postToDelete = null;
  });

  delModalConfirm?.addEventListener('click', () => {
    if (!postToDelete) return;
    const item = document.querySelector(`.catalog-item[data-slug="${postToDelete.slug}"]`);
    if (item) {
      item.remove();
      existingPosts = existingPosts.filter(p => p.slug !== postToDelete.slug);
      document.getElementById('catalog-count-badge').textContent = existingPosts.length;
      showToast(`Removed "${postToDelete.title}" from catalog view`);
    }
    deleteModal.classList.add('hidden');
    postToDelete = null;
  });

  // Filter Catalog
  document.getElementById('existing-search')?.addEventListener('input', (e) => {
    const q = e.target.value.toLowerCase();
    document.querySelectorAll('.catalog-item').forEach(item => {
      const match = item.dataset.title.toLowerCase().includes(q) || item.dataset.slug.toLowerCase().includes(q);
      item.style.display = match ? '' : 'none';
    });
  });

  // Clear form
  document.getElementById('btn-clear-form')?.addEventListener('click', () => {
    if (confirm("Clear all fields in this form?")) {
      document.getElementById('content-form').reset();
      slugInput.dataset.manuallyEdited = "";
      setTipColor("bg-purple-500", "Purple");
      setThemeClass("from-slate-950 via-purple-950 to-stone-950 text-purple-100", "Poetic Violet");
      updateLivePreview();
      showToast("Form cleared");
    }
  });

  // -------------------------------------------------------------
  // SITE SETTINGS STUDIO (Local Configuration & Export)
  // -------------------------------------------------------------
  const initialSiteConfig = (typeof siteConfig !== 'undefined' && siteConfig) ? siteConfig : defaultSiteConfig;
  let activeSiteConfig = null;
  const cfgStorageKey = 'hk_cms_site_config';

  function updateStorageStatusBadge(isSavedLocally) {
    const badge = document.getElementById('config-storage-status');
    if (!badge) return;
    if (isSavedLocally) {
      badge.textContent = "Saved Locally (localStorage)";
      badge.className = "text-[10px] font-mono px-2 py-0.5 rounded bg-emerald-500/10 border border-emerald-500/30 text-emerald-500 font-semibold";
    } else {
      badge.textContent = "Default Loaded";
      badge.className = "text-[10px] font-mono px-2 py-0.5 rounded bg-[var(--bg-primary)] border border-[var(--border-color)] text-[var(--text-secondary)]";
    }
  }

  function loadStoredSiteConfig() {
    try {
      const stored = localStorage.getItem(cfgStorageKey);
      if (stored) {
        return JSON.parse(stored);
      }
    } catch (e) {
      console.error("Could not parse saved site config", e);
    }
    return null;
  }

  const storedCfg = loadStoredSiteConfig();
  if (storedCfg) {
    activeSiteConfig = storedCfg;
    updateStorageStatusBadge(true);
  } else {
    activeSiteConfig = JSON.parse(JSON.stringify(initialSiteConfig));
    updateStorageStatusBadge(false);
  }

  function renderNavList() {
    const container = document.getElementById('cfg-nav-list');
    if (!container || !activeSiteConfig.navigation) return;

    activeSiteConfig.navigation.sort((a, b) => a.order - b.order);

    container.innerHTML = activeSiteConfig.navigation.map((item, idx) => `
      <div class="p-3 rounded-xl border border-[var(--border-color)] bg-[var(--bg-secondary)]/30 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs" data-id="${item.id}">
        <div class="flex items-center gap-3">
          <div class="flex flex-col gap-1 shrink-0">
            <button
              type="button"
              class="btn-nav-up min-h-[30px] min-w-[30px] p-1.5 rounded hover:bg-[var(--bg-primary)] border border-[var(--border-color)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors ${idx === 0 ? 'opacity-30 cursor-not-allowed' : 'cursor-pointer'}"
              data-idx="${idx}"
              ${idx === 0 ? 'disabled' : ''}
              title="Move Up"
              aria-label="Move Up"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"></path></svg>
            </button>
            <button
              type="button"
              class="btn-nav-down min-h-[30px] min-w-[30px] p-1.5 rounded hover:bg-[var(--bg-primary)] border border-[var(--border-color)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors ${idx === activeSiteConfig.navigation.length - 1 ? 'opacity-30 cursor-not-allowed' : 'cursor-pointer'}"
              data-idx="${idx}"
              ${idx === activeSiteConfig.navigation.length - 1 ? 'disabled' : ''}
              title="Move Down"
              aria-label="Move Down"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </button>
          </div>
          <span class="w-6 text-center font-mono text-[10px] text-[var(--text-secondary)] font-bold">#${item.order}</span>
          <div class="space-y-0.5">
            <span class="font-mono text-[10px] text-[var(--accent)] font-semibold block">${item.href}</span>
            <input
              type="text"
              class="nav-label-input px-2.5 py-1.5 rounded-lg border border-[var(--border-color)] bg-[var(--bg-primary)] text-xs text-[var(--text-primary)] font-semibold w-36 sm:w-48"
              value="${item.label}"
              data-id="${item.id}"
            />
          </div>
        </div>

        <div class="flex items-center gap-3">
          <label class="inline-flex items-center gap-2 cursor-pointer select-none">
            <input
              type="checkbox"
              class="nav-enabled-toggle rounded border-[var(--border-color)] w-4 h-4 text-[var(--accent)]"
              data-id="${item.id}"
              ${item.enabled !== false ? 'checked' : ''}
            />
            <span class="text-xs text-[var(--text-secondary)]">Visible in Header</span>
          </label>
        </div>
      </div>
    `).join('');

    container.querySelectorAll('.btn-nav-up').forEach(btn => {
      btn.addEventListener('click', () => {
        const idx = parseInt(btn.dataset.idx);
        if (idx > 0) {
          const prev = activeSiteConfig.navigation[idx - 1];
          const curr = activeSiteConfig.navigation[idx];
          const tmpOrder = prev.order;
          prev.order = curr.order;
          curr.order = tmpOrder;
          renderNavList();
          updateSiteConfigCodeOutput();
        }
      });
    });

    container.querySelectorAll('.btn-nav-down').forEach(btn => {
      btn.addEventListener('click', () => {
        const idx = parseInt(btn.dataset.idx);
        if (idx < activeSiteConfig.navigation.length - 1) {
          const next = activeSiteConfig.navigation[idx + 1];
          const curr = activeSiteConfig.navigation[idx];
          const tmpOrder = next.order;
          next.order = curr.order;
          curr.order = tmpOrder;
          renderNavList();
          updateSiteConfigCodeOutput();
        }
      });
    });

    container.querySelectorAll('.nav-label-input').forEach(input => {
      input.addEventListener('input', () => {
        const id = input.dataset.id;
        const item = activeSiteConfig.navigation.find(x => x.id === id);
        if (item) {
          item.label = input.value;
          updateSiteConfigCodeOutput();
        }
      });
    });

    container.querySelectorAll('.nav-enabled-toggle').forEach(chk => {
      chk.addEventListener('change', () => {
        const id = chk.dataset.id;
        const item = activeSiteConfig.navigation.find(x => x.id === id);
        if (item) {
          item.enabled = chk.checked;
          updateSiteConfigCodeOutput();
        }
      });
    });
  }

