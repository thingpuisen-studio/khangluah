      setVal('cfg-spotlight-w1-gloss', c.fieldworkSpotlight.words[0]?.gloss);
      setVal('cfg-spotlight-w2-src', c.fieldworkSpotlight.words[1]?.src);
      setVal('cfg-spotlight-w2-gloss', c.fieldworkSpotlight.words[1]?.gloss);
      setVal('cfg-spotlight-w3-src', c.fieldworkSpotlight.words[2]?.src);
      setVal('cfg-spotlight-w3-gloss', c.fieldworkSpotlight.words[2]?.gloss);
      setVal('cfg-spotlight-w4-src', c.fieldworkSpotlight.words[3]?.src);
      setVal('cfg-spotlight-w4-gloss', c.fieldworkSpotlight.words[3]?.gloss);
    }
    setVal('cfg-spotlight-trans', c.fieldworkSpotlight?.translation);

    // Page Leads
    setVal('cfg-page-research-eyebrow', c.pages?.research?.eyebrow);
    setVal('cfg-page-research-title', c.pages?.research?.title);
    setVal('cfg-page-research-desc', c.pages?.research?.description);

    setVal('cfg-page-feed-eyebrow', c.pages?.feed?.eyebrow);
    setVal('cfg-page-feed-title', c.pages?.feed?.title);
    setVal('cfg-page-feed-desc', c.pages?.feed?.description);

    setVal('cfg-page-poems-eyebrow', c.pages?.poems?.eyebrow);
    setVal('cfg-page-poems-title', c.pages?.poems?.title);
    setVal('cfg-page-poems-desc', c.pages?.poems?.description);

