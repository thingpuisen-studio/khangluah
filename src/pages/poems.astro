---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostPlate from '../components/PostPlate.astro';
import SocialIcon from '../components/SocialIcon.astro';
import { samplePosts, getPostUrl } from '../data/posts';
import { siteConfig } from '../data/siteConfig';
import { url } from '../utils/url';

// Extract all poems and oral literature posts
const poems = samplePosts.filter(
  (p) => p.postType === "poem" || p.category.toLowerCase().includes("poet")
);

const { eyebrow, title, description, themes: poeticThemes } = siteConfig.pages.poems;
---

<BaseLayout
  title={`${title} | ${siteConfig.author.name}`}
  description={description}
  pageType="collection"
  breadcrumbs={[
    { name: "Home", url: "/" },
    { name: "Poems & Homeland Verse", url: "/poems" },
  ]}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 space-y-16">
    
    <!-- Hero Header -->
    <header class="border-b border-[var(--border-color)] pb-10 space-y-6">
      <div>
        <span class="text-xs font-mono uppercase tracking-wider text-[var(--accent)] font-semibold">
          {eyebrow}
        </span>
        <h1 class="text-3xl sm:text-5xl font-bold font-sans tracking-tight text-[var(--text-primary)] mt-1.5 mb-4">
          {title}
        </h1>
        <p class="text-base sm:text-lg font-serif text-[var(--text-secondary)] leading-relaxed max-w-3xl">
          {description}
        </p>
      </div>

      <!-- Quick Context Bar -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 py-4 px-5 rounded-2xl bg-[var(--bg-secondary)]/50 border border-[var(--border-color)] text-center font-sans">
        <div>
          <span class="block text-xl font-bold text-[var(--text-primary)] font-mono">{poems.length}</span>
          <span class="text-xs text-[var(--text-secondary)]">Published Poems</span>
        </div>
        <div class="border-l border-[var(--border-color)]">
          <span class="block text-xl font-bold text-[var(--text-primary)] font-mono">English</span>
          <span class="text-xs text-[var(--text-secondary)]">Language</span>
        </div>
        <div class="border-l border-[var(--border-color)]">
          <span class="block text-xl font-bold text-[var(--text-primary)] font-mono">Lyrical</span>
          <span class="text-xs text-[var(--text-secondary)]">Poetic Style</span>
        </div>
        <div class="border-l border-[var(--border-color)]">
          <span class="block text-xl font-bold text-[var(--text-primary)] font-mono">Nature &amp; Faith</span>
          <span class="text-xs text-[var(--text-secondary)]">Core Themes</span>
        </div>
      </div>
    </header>

    <!-- Poems Collection -->
    <section class="space-y-10">
      <div class="space-y-1">
        <span class="text-xs font-mono uppercase tracking-wider text-[var(--accent)] font-semibold">
          Selected Works
        </span>
        <h2 class="text-2xl font-bold font-sans tracking-tight text-[var(--text-primary)]">
          All Poems
        </h2>
      </div>

      <div class="space-y-10">
        {poems.map((poem) => (
          <article class="group rounded-2xl border border-[var(--border-color)] bg-[var(--bg-primary)] hover:border-[var(--accent)]/40 p-6 sm:p-8 transition-all duration-200 shadow-xs hover:shadow-md">
            <div class="grid grid-cols-1 md:grid-cols-12 gap-6 lg:gap-8 items-center">
              
              <!-- Left: Plate / Monograph Art -->
              <div class="md:col-span-5 lg:col-span-4">
                <a href={getPostUrl(poem)} class="block group-hover:opacity-95 transition-opacity">
                  <PostPlate post={poem} aspect="aspect-[4/3] sm:aspect-[3/4]" />
                </a>
              </div>

              <!-- Right: Content & Excerpt -->
              <div class="md:col-span-7 lg:col-span-8 space-y-4">
                <div class="flex flex-wrap items-center gap-2 text-xs font-sans text-[var(--text-secondary)]">
                  <span class="px-2.5 py-0.5 rounded-full font-mono font-semibold uppercase tracking-wider bg-purple-500/10 text-purple-600 dark:text-purple-400 border border-purple-500/20 text-[11px]">
                    Poetry
                  </span>
                  <span>•</span>
                  <span class="font-mono text-[var(--accent)] font-medium">
                    {poem.language || "English"}
                  </span>
                  <span>•</span>
                  <span>{poem.readingTime}</span>
                </div>

                <h3 class="text-xl sm:text-2xl font-bold font-sans tracking-tight text-[var(--text-primary)] group-hover:text-[var(--accent)] transition-colors leading-snug">
                  <a href={getPostUrl(poem)}>
                    {poem.title}
                  </a>
                </h3>

                {poem.subtitle && (
                  <p class="text-xs sm:text-sm font-sans font-medium text-[var(--text-secondary)]">
                    {poem.subtitle}
                  </p>
                )}

                <!-- Featured Stanza Blockquote -->
                {poem.sections?.find((s) => s.blockquote)?.blockquote && (
                  <blockquote class="p-4 rounded-xl bg-[var(--bg-secondary)]/60 border-l-4 border-purple-500/60 font-serif italic text-sm text-[var(--text-primary)] leading-relaxed space-y-1">
                    <p class="font-semibold text-xs tracking-wider uppercase font-mono not-italic text-[var(--accent)] mb-1">
                      Featured Stanza:
                    </p>
                    <div class="whitespace-pre-line">
                      {poem.sections.find((s) => s.blockquote)?.blockquote?.text}
                    </div>
                  </blockquote>
                )}

                <p class="text-sm font-serif text-[var(--text-secondary)] leading-relaxed line-clamp-2">
                  {poem.excerpt}
                </p>

                <!-- Tags & Action -->
                <div class="pt-2 flex flex-wrap items-center justify-between gap-3">
                  <div class="flex flex-wrap gap-1.5 font-sans">
                    {poem.tags.slice(0, 3).map((tag) => (
                      <span class="text-xs font-mono text-[var(--text-secondary)]">
                        #{tag.toLowerCase()}
                      </span>
                    ))}
                  </div>

                  <a
                    href={getPostUrl(poem)}
                    class="min-h-[40px] px-4 py-2 rounded-lg bg-[var(--text-primary)] text-[var(--bg-primary)] hover:opacity-90 font-sans font-semibold text-xs transition-opacity inline-flex items-center gap-1.5"
                  >
                    <span>Read Full Poem</span>
                    <span>→</span>
                  </a>
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Themes Overview -->
    <section class="space-y-6 pt-4 border-t border-[var(--border-color)]">
      <div class="space-y-1">
        <span class="text-xs font-mono uppercase tracking-wider text-[var(--accent)] font-semibold">
          Themes &amp; Inspiration
        </span>
        <h2 class="text-2xl font-bold font-sans tracking-tight text-[var(--text-primary)]">
          Poetic Themes
        </h2>
        <p class="text-xs sm:text-sm font-serif text-[var(--text-secondary)] leading-relaxed">
          The poems reflect four core themes rooted in everyday moments, seasonal shifts, and contemplation.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 font-sans">
        {poeticThemes.map((item) => (
          <div class="p-5 rounded-2xl border border-[var(--border-color)] bg-[var(--bg-secondary)]/30 space-y-2">
            <div class="flex items-center justify-between">
              <h3 class="font-bold text-base text-[var(--text-primary)]">
                {item.title}
              </h3>
              <span class="text-xs font-mono text-[var(--accent)] font-semibold">
                {item.theme}
              </span>
            </div>
            <p class="text-xs sm:text-sm font-serif text-[var(--text-secondary)] leading-relaxed">
              {item.desc}
            </p>
          </div>
        ))}
      </div>
    </section>

  </div>
</BaseLayout>
