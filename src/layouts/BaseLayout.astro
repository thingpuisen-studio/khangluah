---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { url } from '../utils/url';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = "H. Kapginlian | Linguist & Researcher",
  description = "Linguistics research, field notes, morphosyntax, and language documentation by H. Kapginlian.",
  ogImage = "https://placehold.co/1200x630/1c1917/ffffff?text=H.+Kapginlian+Linguistics",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href={url("/favicon.svg")} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />

    <!-- Academic Fonts: Inter (UI), Newsreader (Prose), Charis SIL (Linguistic IPA & Tones), JetBrains Mono (Code/Gloss) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Charis+SIL:ital,wght@0,400;0,700;1,400;1,700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500&display=swap"
      rel="stylesheet"
    />

    <!-- Theme detection before render — dark is the site default -->
    <script is:inline>
      if (localStorage.getItem('color-theme') === 'light') {
        document.documentElement.classList.remove('dark');
      } else {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body class="min-h-[100dvh] flex flex-col antialiased selection:bg-[var(--accent-light)] selection:text-[var(--accent)]" id="top">
    <Header />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />
  </body>
</html>
