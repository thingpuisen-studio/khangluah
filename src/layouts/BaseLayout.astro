---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { url } from '../utils/url';
import { generateJsonLdGraph, toAbsoluteUrl, type BreadcrumbItem } from '../utils/schema';
import { siteConfig } from '../data/siteConfig';
import type { Post } from '../data/posts';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  showHeader?: boolean;
  showFooter?: boolean;
  pageType?: 'website' | 'profile' | 'collection' | 'article' | 'scholarly_article';
  post?: Post;
  breadcrumbs?: BreadcrumbItem[];
  customJsonLd?: Record<string, any>;
}

const {
  title = siteConfig.meta.siteTitle,
  description = siteConfig.meta.siteDescription,
  ogImage = "/images/author-centered.jpg",
  canonicalUrl: propCanonicalUrl,
  showHeader = true,
  showFooter = true,
  pageType = 'website',
  post,
  breadcrumbs,
  customJsonLd,
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.origin : 'https://lianhangluah.com';
const canonicalUrl = propCanonicalUrl || (Astro.url ? new URL(Astro.url.pathname, siteUrl).href : siteUrl);
const absoluteOgImage = toAbsoluteUrl(ogImage, siteUrl);

const jsonLdGraph = customJsonLd || generateJsonLdGraph({
  siteUrl,
  canonicalUrl,
  pageType,
  title,
  description,
  post,
  breadcrumbs,
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href={url("/favicon.svg")} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />

    {siteConfig.meta.googleSiteVerification && (
      <meta name="google-site-verification" content={siteConfig.meta.googleSiteVerification} />
    )}

    <!-- Open Graph / Social Sharing -->
    <meta property="og:type" content={post ? "article" : "website"} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:site_name" content={siteConfig.meta.siteTitle} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />

    <!-- Google Search Console & Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdGraph)} />

    <!-- Academic Fonts: Inter (UI), Newsreader (Prose), Charis SIL (Linguistic IPA & Tones), JetBrains Mono (Code/Gloss) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Charis+SIL:ital,wght@0,400;0,700;1,400;1,700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500&display=swap"
      rel="stylesheet"
    />

    <!-- Theme detection before render — dark is the site default -->
    <script is:inline>
      if (localStorage.getItem('color-theme') === 'light') {
        document.documentElement.classList.remove('dark');
      } else {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body class="min-h-[100dvh] flex flex-col antialiased selection:bg-[var(--accent-light)] selection:text-[var(--accent)]" id="top">
    {showHeader && <Header />}
    <main class="flex-grow">
      <slot />
    </main>
    {showFooter && <Footer />}
  </body>
</html>
