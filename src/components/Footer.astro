---
import { url } from '../utils/url';
import SocialIcon from './SocialIcon.astro';
import { siteConfig } from '../data/siteConfig';

const currentYear = new Date().getFullYear();
const activeNav = siteConfig.navigation
  .filter((item) => item.enabled)
  .sort((a, b) => a.order - b.order);
---

<footer class="mt-20 border-t border-[var(--border-color)] bg-[var(--bg-secondary)]/50 py-12 transition-colors duration-200">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 mb-8 font-sans">
      <!-- Col 1: Scholar Bio -->
      <div class="md:col-span-5 space-y-3">
        <h3 class="text-base font-bold text-[var(--text-primary)]">{siteConfig.author.name}</h3>
        <p class="text-xs sm:text-sm text-[var(--text-secondary)] font-serif leading-relaxed">
          {siteConfig.footer.bio}
        </p>
        <p class="text-xs font-mono text-[var(--text-secondary)]">
          {siteConfig.footer.documentedLanguages}
        </p>
      </div>

      <!-- Col 2: Navigation -->
      <div class="md:col-span-4 space-y-2">
        <h4 class="text-xs font-mono font-bold uppercase tracking-wider text-[var(--text-secondary)]">Navigation</h4>
        <ul class="text-xs sm:text-sm space-y-1.5 font-sans">
          {activeNav.map((item) => (
            <li>
              <a href={url(item.href)} class="text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors py-0.5 inline-block">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Legal & Citations -->
      <div class="md:col-span-3 space-y-2">
        <h4 class="text-xs font-mono font-bold uppercase tracking-wider text-[var(--text-secondary)]">Archive &amp; Legal</h4>
        <ul class="text-xs sm:text-sm space-y-1.5 font-sans">
          {siteConfig.author.orcid && (
            <li>
              <a href={`https://orcid.org/${siteConfig.author.orcid}`} target="_blank" rel="noopener noreferrer" class="text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors py-0.5 inline-flex items-center gap-1.5">
                <span>ORCID Registry</span>
                <SocialIcon name="external" class="w-3 h-3 opacity-70" />
              </a>
            </li>
          )}
          <li><a href={url("/terms")} class="text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors py-0.5 inline-block">Terms &amp; Citation Use</a></li>
          <li><a href={url("/privacy")} class="text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors py-0.5 inline-block">Privacy Policy</a></li>
          {siteConfig.footer.showAdminLink && (
            <li><a href={url("/admin")} class="text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors py-0.5 inline-flex items-center gap-1"><span>{siteConfig.footer.adminLinkLabel}</span><span class="text-[10px] font-mono px-1.5 py-0.2 rounded bg-[var(--accent-light)] text-[var(--accent)]">Local</span></a></li>
          )}
        </ul>
      </div>
    </div>

    <div class="pt-6 border-t border-[var(--border-color)] flex flex-col sm:flex-row items-center justify-between text-xs text-[var(--text-secondary)] font-sans gap-3">
      <p>&copy; {currentYear} {siteConfig.footer.copyright}</p>
      <p class="flex items-center gap-4">
        <span>{siteConfig.footer.standardsNotice}</span>
        <span>&bull;</span>
        <a href="#top" class="hover:text-[var(--text-primary)] transition-colors">{siteConfig.footer.backToTopText} &uarr;</a>
      </p>
    </div>
  </div>
</footer>

